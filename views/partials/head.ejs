<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (typeof csrfToken !== 'undefined') { %>
<meta name="csrf-token" content="<%= csrfToken %>">
<% } %>
<script>
// 모든 fetch POST/PUT/DELETE/PATCH 요청에 CSRF 토큰 자동 포함
(function() {
  var token = document.querySelector('meta[name="csrf-token"]');
  if (!token) return;
  var csrfValue = token.content;
  var _fetch = window.fetch;
  // 같은 출처 요청에만 토큰을 붙인다. 외부 도메인(예: 토스페이먼츠 SDK의 로그·모니터링 요청)에도
  // 붙이면 토큰이 제3자에게 전달되고, 허용되지 않은 헤더라 CORS 사전 요청이 막힌다.
  function isSameOrigin(url) {
    try {
      var raw = (url && url.url) ? url.url : String(url);
      return new URL(raw, window.location.href).origin === window.location.origin;
    } catch (e) { return false; }
  }
  window.fetch = function(url, opts) {
    opts = opts || {};
    var method = (opts.method || 'GET').toUpperCase();
    if ((method === 'POST' || method === 'PUT' || method === 'DELETE' || method === 'PATCH') && isSameOrigin(url)) {
      opts.headers = Object.assign({ 'X-CSRF-Token': csrfValue }, opts.headers);
    }
    return _fetch.call(this, url, opts);
  };
})();
</script>
<title><%= typeof title !== 'undefined' ? title : 'AcadMe' %> — 학사관리 플랫폼</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/css/style.css" rel="stylesheet">
<style>
  input[type="password"]::-ms-reveal,
  input[type="password"]::-ms-clear { display: none; }
</style>
