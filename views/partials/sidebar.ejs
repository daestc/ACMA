<div id="sidebar-backdrop" class="sidebar-backdrop" onclick="closeSidebar()"></div>

<% if (user && user.role === 'staff') { %>
  <%- include('./sidebar-staff', { currentPage, user }) %>
<% } else { %>

<aside class="sidebar" id="app-sidebar">
  <div class="sidebar-header">
    <div class="sidebar-header-left">
      <div class="s-logo">A</div>
      <span class="s-logo-text">AcadMe</span>
    </div>
    <button class="sidebar-close" onclick="closeSidebar()">✕</button>
  </div>

  <div class="sidebar-user">
    <div class="user-info">
      <div class="user-avatar"><%= user ? user.name[0] : '' %></div>
      <div>
        <div class="user-name"><%= user ? user.name : '' %></div>
        <div class="user-role"><%= user ? user.major : '' %></div>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <div class="nav-label">메인</div>
      <a href="/home"     class="nav-item <%= currentPage === 'home'     ? 'active' : '' %>"><span class="nav-icon">🏠</span>홈</a>
      <a href="/calendar" class="nav-item <%= currentPage === 'calendar' ? 'active' : '' %>"><span class="nav-icon">📅</span>캘린더</a>
      <a href="/mystatus" class="nav-item <%= currentPage === 'mystatus' ? 'active' : '' %>"><span class="nav-icon">⭐</span>MyStatus</a>
    </div>
    <div class="nav-section">
      <div class="nav-label">학업</div>
      <a href="/notice"   class="nav-item <%= currentPage === 'notice'   ? 'active' : '' %>">
        <span class="nav-icon">📢</span>공지사항
      </a>
      <a href="/academic" class="nav-item <%= currentPage === 'academic' ? 'active' : '' %>"><span class="nav-icon">🎓</span>학사관리</a>
      <a href="/study"    class="nav-item <%= currentPage === 'study'    ? 'active' : '' %>"><span class="nav-icon">📖</span>공부</a>
      <a href="/suggestions" class="nav-item <%= currentPage === 'suggestions' ? 'active' : '' %>"><span class="nav-icon">💬</span>건의 게시판</a>
    </div>
    <div class="nav-section">
      <div class="nav-label">진로</div>
      <a href="/career"   class="nav-item <%= currentPage === 'career'   ? 'active' : '' %>"><span class="nav-icon">💼</span>진로정보</a>
    </div>
    <% if (user && user.role === 'admin') { %>
    <div class="nav-section">
      <div class="nav-label">관리</div>
      <a href="/admin/staff" class="nav-item <%= currentPage === 'adminStaff' ? 'active' : '' %>"><span class="nav-icon">✅</span>가입 승인</a>
      <a href="/admin/adminStatistics" class="nav-item <%= currentPage === 'adminStatistics' ? 'active' : '' %>"><span class="nav-icon">📊</span>통계</a>
    </div>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div style="margin-bottom:10px;padding:11px 12px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <span style="font-size:12px;font-weight:600;">내 플랜</span>
        <% if (user && user.planType === 'premium') { %>
          <span style="font-size:11px;background:#EEEDFE;color:#3C3489;padding:2px 8px;border-radius:20px;">프리미엄</span>
        <% } else { %>
          <span style="font-size:11px;background:#E1F5EE;color:#0F6E56;padding:2px 8px;border-radius:20px;">무료</span>
        <% } %>
      </div>
      <% if (user && user.planType !== 'premium') {
        const today = new Date().toISOString().slice(0, 10);
        const quizUsed = (user.dailyUsage?.quiz?.date === today) ? (user.dailyUsage.quiz.count || 0) : 0;
        const sumUsed  = (user.dailyUsage?.summary?.date === today) ? (user.dailyUsage.summary.count || 0) : 0;
        const quizPct  = Math.min(100, Math.round(quizUsed / 10 * 100));
        const sumPct   = Math.min(100, Math.round(sumUsed  / 5  * 100));
      %>
        <div style="margin-bottom:5px;">
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text2);margin-bottom:3px;">
            <span>퀴즈</span><span style="color:var(--text1);font-weight:600;"><%= quizUsed %> / 10</span>
          </div>
          <div style="height:3px;background:var(--border);border-radius:2px;overflow:hidden;">
            <div style="height:100%;width:<%= quizPct %>%;background:#534AB7;border-radius:2px;"></div>
          </div>
        </div>
        <div style="margin-bottom:8px;">
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text2);margin-bottom:3px;">
            <span>요약</span><span style="color:var(--text1);font-weight:600;"><%= sumUsed %> / 5</span>
          </div>
          <div style="height:3px;background:var(--border);border-radius:2px;overflow:hidden;">
            <div style="height:100%;width:<%= sumPct %>%;background:#1D9E75;border-radius:2px;"></div>
          </div>
        </div>
        <a href="/payment" style="display:block;text-align:center;padding:6px;border-radius:8px;border:1px solid var(--border);font-size:12px;color:var(--text2);text-decoration:none;" onmouseover="this.style.background='var(--bg3)'" onmouseout="this.style.background='transparent'">업그레이드 →</a>
      <% } else if (user) { %>
        <div style="font-size:11px;color:var(--text2);margin-bottom:8px;line-height:1.5;">퀴즈 · 요약 무제한 이용 중</div>
        <a href="/payment" style="display:block;text-align:center;padding:6px;border-radius:8px;border:1px solid var(--border);font-size:12px;color:var(--text2);text-decoration:none;" onmouseover="this.style.background='var(--bg3)'" onmouseout="this.style.background='transparent'">플랜 관리</a>
      <% } %>
    </div>
    <div class="nav-item" onclick="logout()"><span class="nav-icon">🚪</span>로그아웃</div>
  </div>
</aside>

<% } %>
