<!--시간표 직접 입력 모달-->
<div id="timetable-modal" class="event-modal" style="display:none;">
  <div class="event-modal-content">
    <h3 id="timetable-modal-title">시간표 추가</h3>

    <form id="timetable-form">
      <input type="hidden" id="timetable-id">

      <label>
        학기 구분
        <select id="tt-semester">
          <option value="">학기 없음</option>
        </select>
      </label>

      <label>
        제목
        <input type="text" id="tt-title" required>
      </label>

      <label>
        장소
        <input type="text" id="tt-location">
      </label>

      <label>
        유형
        <input type="text" id="tt-type" value="lecture" placeholder="lecture, partTime, study 등">
      </label>

      <label>
        교수 이름
        <input type="text" id="tt-professor">
      </label>

      <label>
        학점
        <input type="number" id="tt-credits" min="0" value="0">
      </label>

      <label>
        색상
        <input type="color" id="tt-color" value="#60A5FA">
      </label>

      <div id="tt-schedule-list"></div>

      <button type="button" id="add-schedule-row-btn" class="btn btn-sm">
        +시간 추가
      </button>

      <div style="display:flex; gap:8px; margin-top:16px;">
        <button type="submit" class="btn btn-accent btn-sm">저장</button>
        <button type="button" id="delete-timetable-btn" class="btn btn-sm" style="display:none;">삭제</button>
        <button type="button" id="close-timetable-form-btn" class="btn btn-sm">취소</button>
      </div>
    </form>
  </div>
</div>

<!-- 강의 검색 모달 -->
<div id="lecture-search-modal" class="event-modal" style="display:none;">
  <div class="event-modal-content lecture-search-modal-content">
    <h3>강의 검색</h3>

    <div id="lecture-search-no-univ" class="lecture-search-no-univ" style="display:none;">
      <p class="lecture-search-no-univ-title">대학등록이 필요합니다</p>
      <p class="lecture-search-no-univ-desc">
        마이페이지에서 소속 대학을 등록하면 해당 대학 강의를 검색할 수 있습니다.
      </p>
      <h4 class="lecture-search-univ-heading">등록 가능한 대학</h4>
      <ul id="available-university-list" class="available-university-list"></ul>
      <div id="available-university-pagination" class="available-university-pagination"></div>
    </div>

    <div id="lecture-search-enabled">
      <div class="lecture-search-controls">
        <input type="text" id="lecture-keyword" placeholder="강의명 검색">
        <button type="button" id="search-lecture-btn" class="btn btn-sm">검색</button>
      </div>

      <div id="lecture-search-list"></div>
      <div id="lecture-search-pagination" class="available-university-pagination"></div>
    </div>

    <button type="button" id="close-lecture-search-btn" class="btn btn-sm">닫기</button>
  </div>
</div>