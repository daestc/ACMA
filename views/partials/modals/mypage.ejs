<!-- ══ 마이페이지 모달 ══ -->
<div id="mypage-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.5);z-index:1000;backdrop-filter:blur(4px);align-items:center;justify-content:center;">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px;width:860px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);position:relative;">
    <!-- 모달 헤더 -->
    <div style="padding:22px 28px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--bg2);z-index:10;border-radius:20px 20px 0 0;">
      <div style="font-size:17px;font-weight:800;">👤 마이페이지</div>
      <button onclick="closeMyPageModal()" style="width:32px;height:32px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;color:var(--text2);transition:all .2s;" onmouseover="this.style.background='var(--red-bg)';this.style.color='var(--red)'" onmouseout="this.style.background='var(--bg3)';this.style.color='var(--text2)'">✕</button>
    </div>
    <!-- 모달 바디 -->
    <div style="padding:24px 28px;">
      <!-- 프로필 헤더 -->
      <div class="profile-header" style="margin-bottom:20px;">
        <div class="profile-avatar-lg">김<div class="avatar-edit">✏</div></div>
        <div style="flex:1;">
          <div class="profile-info">
            <div class="name">김민준</div>
            <div class="meta">한국대학교 · 컴퓨터공학과 · 3학년 · 2021XXXXX</div>
          </div>
          <div class="profile-stats">
            <div class="p-stat"><div class="p-stat-value">3.80</div><div class="p-stat-label">누적 GPA</div></div>
            <div class="p-stat"><div class="p-stat-value">92</div><div class="p-stat-label">이수 학점</div></div>
            <div class="p-stat"><div class="p-stat-value">6</div><div class="p-stat-label">이수 학기</div></div>
            <div class="p-stat"><div class="p-stat-value">3</div><div class="p-stat-label">취득 자격증</div></div>
          </div>
        </div>
      </div>
      <div class="grid-2">
        <div>
          <div class="settings-section" id="profile-settings">
            <h3>학사정보</h3>
            <div class="form-group"><label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:5px;">학번</label><input class="input-field" value="2021XXXXX" style="width:100%;" id="studentId"></div>
            <div class="form-group"><label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:5px;">대학</label><input class="input-field" value="한국대학교" style="width:100%;" id="university"></div>
            <div class="form-group"><label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:5px;">주전공-복수전공</label><input class="input-field" value="컴퓨터공학과" style="width:100%;" id="major"></div>
            <div class="form-group"><label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:5px;">재학상태</label><select class="input-field" style="width:100%;" id="enrollmentStatus"><option>재학</option><option>휴학</option><option>졸업</option></select></div>
            <button class="btn btn-accent btn-sm" onclick="saveProfile()">저장</button>
          </div>
          <div class="settings-section">
            <h3>보안</h3>
            <div class="settings-row"><div><div class="settings-label">비밀번호 변경</div><div class="settings-desc">마지막 변경: 2025.11.20</div></div><button class="btn btn-ghost btn-sm" onclick="openChangePwModal()">변경</button></div>
            <div class="settings-row"><div><div class="settings-label">2단계 인증</div><div class="settings-desc">OTP 앱으로 추가 인증</div></div><div class="toggle on" onclick="this.classList.toggle('on')"><div class="toggle-knob"></div></div></div>
          </div>
        </div>
        <div>
          <div class="settings-section">
            <h3>알림 설정</h3>
            <div class="settings-row"><div><div class="settings-label">일일 강의 스케줄 알림</div><div class="settings-desc">매일 오전 8시</div></div><div class="toggle on" onclick="this.classList.toggle('on')"><div class="toggle-knob"></div></div></div>
            <div class="settings-row"><div><div class="settings-label">D-Day 알림</div><div class="settings-desc">자격증, 장학금, 시험</div></div><div class="toggle on" onclick="this.classList.toggle('on')"><div class="toggle-knob"></div></div></div>
            <div class="settings-row"><div><div class="settings-label">푸시 알림</div><div class="settings-desc">브라우저 푸시</div></div><div class="toggle" onclick="this.classList.toggle('on')"><div class="toggle-knob"></div></div></div>
          </div>
          <div class="settings-section">
            <h3>계정</h3>
            <div class="settings-row"><div><div class="settings-label">로그아웃</div><div class="settings-desc">현재 세션을 종료합니다</div></div><button class="btn btn-ghost btn-sm" onclick="serverLogout()">로그아웃</button></div>
            <div class="settings-row"><div><div class="settings-label">계정 탈퇴</div><div class="settings-desc">모든 데이터가 삭제됩니다</div></div><button class="btn btn-sm" style="color:var(--red);border:1.5px solid #fecdd3;background:#fff1f2;" onclick="openWithdrawModal()">탈퇴</button></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- ══ 비밀번호 변경 모달 ══ -->
<div id="changepw-overlay" style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.6);z-index:1100;align-items:center;justify-content:center;">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:16px;width:420px;max-width:92vw;padding:28px;box-shadow:0 20px 60px rgba(0,0,0,.25);">
    <div style="font-size:16px;font-weight:800;margin-bottom:18px;">비밀번호 변경</div>
    <div style="margin-bottom:12px;">
      <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:6px;">현재 비밀번호</label>
      <div style="position:relative;">
        <input id="current-pw" type="password" class="input-field" placeholder="현재 비밀번호 입력" style="width:100%;padding-right:38px;" onblur="cpwCheck.current()">
        <button type="button" onclick="togglePw('current-pw',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
      <span id="msg-current-pw" style="font-size:12px;margin-top:4px;display:none;"></span>
    </div>
    <div style="margin-bottom:12px;">
      <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:6px;">새 비밀번호</label>
      <div style="position:relative;">
        <input id="new-pw" type="password" class="input-field" placeholder="영문+숫자 포함 8자 이상" style="width:100%;padding-right:38px;" oninput="cpwCheck.newPw()">
        <button type="button" onclick="togglePw('new-pw',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
      <span id="msg-new-pw" style="font-size:12px;margin-top:4px;display:none;"></span>
    </div>
    <div style="margin-bottom:18px;">
      <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:6px;">새 비밀번호 확인</label>
      <div style="position:relative;">
        <input id="new-pw-confirm" type="password" class="input-field" placeholder="새 비밀번호 재입력" style="width:100%;padding-right:38px;" oninput="cpwCheck.confirm()">
        <button type="button" onclick="togglePw('new-pw-confirm',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
      <span id="msg-new-pw-confirm" style="font-size:12px;margin-top:4px;display:none;"></span>
    </div>
    <p id="changepw-error"   style="display:none;font-size:12px;color:var(--red);margin-bottom:12px;"></p>
    <p id="changepw-success" style="display:none;font-size:12px;color:var(--green);margin-bottom:12px;"></p>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button class="btn btn-ghost btn-sm" onclick="closeChangePwModal()">취소</button>
      <button class="btn btn-accent btn-sm" onclick="submitChangePw()">변경하기</button>
    </div>
  </div>
</div>

<!-- ══ 회원 탈퇴 확인 모달 ══ -->
<div id="withdraw-overlay" style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.6);z-index:1100;align-items:center;justify-content:center;">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:16px;width:420px;max-width:92vw;padding:28px;box-shadow:0 20px 60px rgba(0,0,0,.25);">
    <div style="font-size:16px;font-weight:800;margin-bottom:6px;">계정 탈퇴</div>
    <p style="font-size:13px;color:var(--text2);margin-bottom:20px;">탈퇴하면 모든 데이터가 <strong>영구 삭제</strong>되며 복구할 수 없습니다.</p>

    <!-- local 전용 비밀번호 입력 -->
    <div id="withdraw-pw-wrap" style="display:none;margin-bottom:16px;">
      <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;margin-bottom:6px;">본인 확인을 위해 비밀번호를 입력해주세요</label>
      <div style="position:relative;">
        <input id="withdraw-pw" type="password" class="input-field" placeholder="비밀번호 입력" style="width:100%;padding-right:38px;">
        <button type="button" onclick="togglePw('withdraw-pw',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
    </div>

    <!-- 소셜 전용 안내 -->
    <div id="withdraw-social-wrap" style="display:none;margin-bottom:16px;">
      <p style="font-size:13px;color:var(--text2);background:var(--bg3);border-radius:8px;padding:12px;">소셜 계정으로 로그인된 상태입니다.<br>아래 버튼을 누르면 즉시 탈퇴 처리됩니다.</p>
    </div>

    <p id="withdraw-error" style="display:none;font-size:12px;color:var(--red);margin-bottom:12px;"></p>

    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button class="btn btn-ghost btn-sm" onclick="closeWithdrawModal()">취소</button>
      <button class="btn btn-sm" style="background:var(--red);color:#fff;border:none;" onclick="submitWithdraw()">탈퇴하기</button>
    </div>
  </div>
</div>

<script src="/js/mypage.js"></script>