<!-- ══ 직무 세부 모달 ══ -->
<div id="job-detail-modal" style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.5);z-index:1000;backdrop-filter:blur(4px);align-items:center;justify-content:center;">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px;width:600px;max-width:95vw;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--bg2);z-index:10;border-radius:20px 20px 0 0;">
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;">💼 직무 상세 정보</div>
        <div id="jd-title" style="font-size:18px;font-weight:800;color:var(--text);">웹 개발자</div>
      </div>
      <button onclick="document.getElementById('job-detail-modal').style.display='none'" style="width:30px;height:30px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;color:var(--text2);">✕</button>
    </div>
    <div style="padding:22px 24px;display:flex;flex-direction:column;gap:16px;">
      <!-- 관련 학과 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">🎓 관련 학과</div>
        <div id="jd-departments" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
      </div>
      <!-- 직무 설명 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">📋 직무 설명</div>
        <div id="jd-desc" style="font-size:13px;color:var(--text2);line-height:1.7;background:var(--bg3);border-radius:var(--radius-sm);padding:14px;"></div>
      </div>
      <!-- 주요 기술 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">⚡ 주요 기술</div>
        <div id="jd-skills" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
      </div>
      <!-- 관련 자격증 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">🏆 관련 자격증</div>
        <div id="jd-certs" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
      </div>
    </div>
  </div>
</div>

