<!-- ══ 직무 세부 모달 ══ -->
<div id="job-detail-modal" style="display:none;position:fixed;inset:0;background:rgba(17,20,45,.56);z-index:1000;backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px;">
  <div class="job-detail-modal-shell">
    <div class="job-detail-modal-accent"></div>

    <!-- 헤더 -->
    <div class="job-detail-modal-header">
      <div>
        <div class="job-detail-modal-kicker">💼 직무 상세 정보</div>
        <div id="jd-title" class="job-detail-modal-title"></div>
        <div id="jd-category" class="job-detail-modal-category"></div>
      </div>
      <button onclick="document.getElementById('job-detail-modal').style.display='none'"
              class="job-detail-modal-close">✕</button>
    </div>

    <!-- 본문 -->
    <div class="job-detail-modal-body">
      <div class="job-detail-hero">
        <div class="job-detail-hero-left">
          <div class="job-detail-section-label"><span class="icon">📋</span> 직무 개요</div>
          <div id="jd-desc" class="job-detail-copy"></div>
        </div>
        <div class="job-detail-hero-right">
          <div class="job-detail-section-label"><span class="icon">💰</span> 평균 연봉</div>
          <div class="job-detail-salary-grid">
            <div class="job-salary-card">
              <div id="jd-sal-lower" class="job-salary-value"></div>
              <div class="job-salary-label">하위 25%</div>
            </div>
            <div class="job-salary-card job-salary-card--featured">
              <div id="jd-sal-median" class="job-salary-value job-salary-value--featured"></div>
              <div class="job-salary-label">평균</div>
            </div>
            <div class="job-salary-card">
              <div id="jd-sal-upper" class="job-salary-value"></div>
              <div class="job-salary-label">상위 25%</div>
            </div>
          </div>
        </div>
      </div>
       <!-- ✅ 새로 추가: 주요 업무 -->
      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">📝</span> 주요 업무</div>
        <div id="jd-responsibilities" class="job-detail-resp-list"></div>
      </div>

      <!-- 되는 법 -->
      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">🛤️</span> 되는 법</div>
        <div id="jd-way" class="job-detail-copy job-detail-copy--preline"></div>
      </div>

      <!-- 업무 수행 능력 / 관련 지식 -->
      <div class="job-detail-grid-2">
        <div class="job-detail-panel">
          <div class="job-detail-section-label"><span class="icon">⚡</span> 업무 수행 능력</div>
          <div id="jd-abilities" class="job-detail-tags"></div>
        </div>
        <div class="job-detail-panel">
          <div class="job-detail-section-label"><span class="icon">📚</span> 관련 지식</div>
          <div id="jd-knowledge" class="job-detail-tags"></div>
        </div>
      </div>

      <!-- 업무 관련 성격 -->
      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">😊</span> 업무 관련 성격</div>
        <div id="jd-characteristics" class="job-detail-tags"></div>
      </div>

      <!-- 관련 학과 / 관련 자격증 -->
      <div class="job-detail-grid-2">
        <div class="job-detail-panel">
          <div class="job-detail-section-label"><span class="icon">🎓</span> 관련 학과</div>
          <div id="jd-departments" class="job-detail-tags"></div>
        </div>
        <div class="job-detail-panel">
          <div class="job-detail-section-label"><span class="icon">🏆</span> 관련 자격증</div>
          <div id="jd-certs" class="job-detail-tags"></div>
        </div>
      </div>

      <!-- 관련 직업 -->
      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">👥</span> 관련 직업</div>
        <div id="jd-occupations" class="job-detail-tags"></div>
      </div>
    </div>
    <button id="jd-save-btn" class="btn btn-accent">이 직무 선택</button>
  </div>
</div>