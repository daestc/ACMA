<!-- 수상경력 추가 모달 -->
<div class="spec-modal" id="award-modal" hidden>
  <div class="spec-modal-content" role="dialog" aria-modal="true" aria-labelledby="award-modal-title">
    <div class="spec-modal-header">
      <h3 id="award-modal-title">수상경력 추가</h3>
      <button type="button" class="spec-modal-close" data-modal-close aria-label="닫기">&times;</button>
    </div>

    <div class="spec-modal-form">
      <div class="spec-field">
        <label for="award-name">수상명 <span class="spec-required">*</span></label>
        <input type="text" id="award-name" placeholder="예: 캡스톤디자인 경진대회" />
      </div>

      <div class="spec-field">
        <label for="award-organizer">주최 기관</label>
        <input type="text" id="award-organizer" placeholder="예: 한국정보처리학회" />
      </div>

      <div class="spec-field">
        <label for="award-rank">수상 등급</label>
        <input type="text" id="award-rank" placeholder="예: 최우수상, 금상" />
      </div>

      <div class="spec-field">
        <label for="award-acquired-date">취득일</label>
        <input type="date" id="award-acquired-date" />
      </div>

      <p class="spec-error" data-modal-error hidden></p>

      <div class="spec-modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-cancel>취소</button>
        <button type="button" class="btn btn-accent" data-modal-submit>저장</button>
      </div>
    </div>
  </div>
</div>