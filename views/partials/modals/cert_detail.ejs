<!-- ══ 자격증 세부 모달 ══ -->
<div id="cert-detail-modal" style="display:none;position:fixed;inset:0;background:rgba(17,20,45,.56);z-index:1000;backdrop-filter:blur(8px);align-items:center;justify-content:center;padding:20px;">
  <div class="job-detail-modal-shell" style="width:min(720px,96vw);">
    <div class="job-detail-modal-accent"></div>

    <div class="job-detail-modal-header">
      <div>
        <div class="job-detail-modal-kicker">📋 자격증 상세 정보</div>
        <div id="cd-title" class="job-detail-modal-title">정보처리기사</div>
        <div id="cd-category" class="job-detail-modal-category">국가기술자격</div>
      </div>
      <button onclick="document.getElementById('cert-detail-modal').style.display='none'" class="job-detail-modal-close">✕</button>
    </div>

    <div class="job-detail-modal-body">
      <div class="job-detail-grid-2">
        <div class="job-detail-hero-left">
          <div class="job-detail-section-label"><span class="icon">📌</span> 자격증 개요</div>
          <div id="cd-overview" class="job-detail-copy"></div>
        </div>
        <div class="job-detail-hero-right">
          <div class="job-detail-section-label"><span class="icon">📈</span> 진로 및 전망</div>
          <div id="cd-prospect" class="job-detail-copy"></div>
        </div>
      </div>

      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">🛤️</span> 취득방법</div>
        <div id="cd-way" class="job-detail-resp-list"></div>
      </div>
      
      <div class="job-detail-panel">
        <div class="job-detail-section-label"><span class="icon">👥</span> 관련 직무</div>
        <div id="cd-related-jobs" class="job-detail-tags cert-tags"></div>
      </div>
    
      <div style="display:flex;gap:10px;align-items:center;justify-content:flex-end;padding-top:6px;">
        <a id="cd-qnet-link" class="qnet-link" href="#" target="_blank" style="display:none;">🔗 Q-net</a>
        <button id="cd-save-btn" class="btn btn-accent">자격증 저장</button>
      </div>
    </div>
  </div>
</div>

