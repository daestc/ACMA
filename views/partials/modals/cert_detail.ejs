<!-- ══ 자격증 세부 모달 ══ -->
<div id="cert-detail-modal" style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.5);z-index:1000;backdrop-filter:blur(4px);align-items:center;justify-content:center;">
  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px;width:560px;max-width:95vw;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--bg2);z-index:10;border-radius:20px 20px 0 0;">
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;">📋 자격증 세부 정보</div>
        <div id="cd-title" style="font-size:18px;font-weight:800;color:var(--text);">정보처리기사</div>
      </div>
      <button onclick="document.getElementById('cert-detail-modal').style.display='none'" style="width:30px;height:30px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;color:var(--text2);">✕</button>
    </div>
    <div style="padding:22px 24px;display:flex;flex-direction:column;gap:16px;">
      <!-- 자격증 개요 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">📌 자격증 개요</div>
        <div id="cd-overview" style="font-size:13px;color:var(--text2);line-height:1.7;background:var(--bg3);border-radius:var(--radius-sm);padding:14px;"></div>
      </div>
      <!-- 진로 및 전망 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">📈 진로 및 전망</div>
        <div id="cd-prospect" style="font-size:13px;color:var(--text2);line-height:1.7;background:var(--bg3);border-radius:var(--radius-sm);padding:14px;"></div>
      </div>
      <!-- 수행 직무 -->
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">💼 수행 직무</div>
        <div id="cd-duties" style="display:flex;flex-direction:column;gap:6px;"></div>
      </div>
    </div>
  </div>
</div>

