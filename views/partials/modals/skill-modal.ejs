<!-- 스킬 추가 모달 -->
<div class="spec-modal" id="skill-modal" hidden>
  <div class="spec-modal-content" role="dialog" aria-modal="true" aria-labelledby="skill-modal-title">
    <div class="spec-modal-header">
      <h3 id="skill-modal-title" data-modal-title>스킬 추가</h3>
      <button type="button" class="spec-modal-close" data-modal-close aria-label="닫기">&times;</button>
    </div>

    <div class="spec-modal-form">
      <div class="spec-field">
        <label for="skill-name">스킬명 <span class="spec-required">*</span></label>
        <input type="text" id="skill-name" placeholder="예: React, SQL, Figma" />
      </div>

      <div class="spec-field">
        <label for="skill-level">숙련도 <span class="spec-required">*</span></label>
        <select id="skill-level">
          <option value="" disabled selected>선택</option>
          <option value="하급">하급</option>
          <option value="중급">중급</option>
          <option value="고급">고급</option>
        </select>
      </div>

      <p class="spec-error" data-modal-error hidden></p>

      <div class="spec-modal-footer">
        <button type="button" class="btn btn-ghost" data-modal-delete hidden style="margin-right:auto;color:var(--red);">삭제</button>
        <button type="button" class="btn btn-ghost" data-modal-cancel>취소</button>
        <button type="button" class="btn btn-accent" data-modal-submit>저장</button>
      </div>
    </div>
  </div>
</div>
