<!-- ══ 습관 트래커 추가/수정 모달 ══ -->
<div id="habit-modal-overlay"
  style="display:none;position:fixed;inset:0;background:rgba(23,25,43,.5);z-index:1000;
         backdrop-filter:blur(4px);align-items:center;justify-content:center;"
  onclick="if(event.target===this) closeHabitModal()">

  <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px;
              width:480px;max-width:95vw;box-shadow:0 20px 60px rgba(0,0,0,.2);position:relative;">

    <!-- 모달 헤더 -->
    <div style="padding:20px 24px 18px;border-bottom:1px solid var(--border);
                display:flex;align-items:center;justify-content:space-between;">
      <div style="font-size:16px;font-weight:800;">🌱 습관 관리</div>
      <button onclick="closeHabitModal()"
        style="width:30px;height:30px;background:var(--bg3);border:1px solid var(--border);
               border-radius:8px;display:flex;align-items:center;justify-content:center;
               font-size:14px;cursor:pointer;color:var(--text2);transition:all .2s;"
        onmouseover="this.style.background='var(--red-bg)';this.style.color='var(--red)'"
        onmouseout="this.style.background='var(--bg3)';this.style.color='var(--text2)'">✕</button>
    </div>

    <!-- 탭 선택 (추가 / 수정) -->
    <div style="padding:18px 24px 0;">
      <div style="display:flex;gap:0;background:var(--bg3);border:1px solid var(--border);
                  border-radius:var(--radius-sm);padding:3px;">
        <button id="habit-tab-add"
          onclick="switchHabitTab('add')"
          style="flex:1;padding:8px;border-radius:6px;font-size:13px;font-weight:700;
                 transition:all .2s;background:var(--accent);color:white;cursor:pointer;">
          ➕ 습관 추가
        </button>
        <button id="habit-tab-edit"
          onclick="switchHabitTab('edit')"
          style="flex:1;padding:8px;border-radius:6px;font-size:13px;font-weight:600;
                 transition:all .2s;background:transparent;color:var(--text2);cursor:pointer;">
          ✏️ 습관 수정
        </button>
      </div>
    </div>

    <!-- 모달 바디 -->
    <div style="padding:20px 24px 24px;">

      <!-- ── 추가 탭 ── -->
      <div id="habit-form-add">
        <div style="margin-bottom:14px;">
          <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;
                        margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px;">습관 이름</label>
          <input id="habit-add-name" class="input-field" type="text"
            placeholder="예: 물 2L 마시기"
            style="width:100%;"
            onkeydown="if(event.key==='Enter') confirmHabitAction()">
        </div>
        <div style="margin-bottom:20px;">
          <label style="font-size:11px;font-weight:700;color:var(--text2);display:block;
                        margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px;">카테고리</label>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;"
               id="habit-category-btns">
            <div class="habit-cat-btn active" onclick="selectHabitCategory(this)" data-cat="건강"
              style="padding:8px 4px;background:var(--green-bg);border:1.5px solid var(--green);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:12px;font-weight:700;color:var(--green);">
              💪 건강
            </div>
            <div class="habit-cat-btn" onclick="selectHabitCategory(this)" data-cat="학습"
              style="padding:8px 4px;background:var(--bg3);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:12px;font-weight:700;color:var(--text2);">
              📖 학습
            </div>
            <div class="habit-cat-btn" onclick="selectHabitCategory(this)" data-cat="마음"
              style="padding:8px 4px;background:var(--bg3);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:12px;font-weight:700;color:var(--text2);">
              🧘 마음
            </div>
            <div class="habit-cat-btn" onclick="selectHabitCategory(this)" data-cat="성장"
              style="padding:8px 4px;background:var(--bg3);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:12px;font-weight:700;color:var(--text2);">
              🌱 성장
            </div>
          </div>
        </div>
        <div style="display:flex;gap:8px;">
          <button onclick="closeHabitModal()" class="btn btn-ghost" style="flex:1;">취소</button>
          <button onclick="confirmHabitAction()" class="btn btn-accent" style="flex:2;">+ 추가</button>
        </div>
      </div>

      <!-- ── 수정 탭 ── -->
      <div id="habit-form-edit" style="display:none;">

        <!-- 습관 목록 -->
        <div style="max-height:280px;overflow-y:auto;margin-bottom:16px;"
             id="habit-edit-list">
          <!-- JS로 렌더링 -->
        </div>

        <!-- 선택된 항목 수정 폼 -->
        <div id="habit-edit-form" style="display:none;padding:16px;background:var(--bg3);
             border-radius:var(--radius-sm);border:1px solid var(--border);margin-bottom:16px;">
          <div style="font-size:12px;font-weight:700;color:var(--text2);margin-bottom:10px;">
            선택한 습관 수정
          </div>
          <div style="margin-bottom:10px;">
            <input id="habit-edit-name" class="input-field" type="text"
              placeholder="습관 이름" style="width:100%;"
              onkeydown="if(event.key==='Enter') confirmHabitEdit()">
          </div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px;"
               id="habit-edit-category-btns">
            <div class="habit-edit-cat-btn" onclick="selectHabitEditCategory(this)" data-cat="건강"
              style="padding:6px 4px;background:var(--bg2);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:11px;font-weight:700;color:var(--text2);">
              💪 건강
            </div>
            <div class="habit-edit-cat-btn" onclick="selectHabitEditCategory(this)" data-cat="학습"
              style="padding:6px 4px;background:var(--bg2);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:11px;font-weight:700;color:var(--text2);">
              📖 학습
            </div>
            <div class="habit-edit-cat-btn" onclick="selectHabitEditCategory(this)" data-cat="마음"
              style="padding:6px 4px;background:var(--bg2);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:11px;font-weight:700;color:var(--text2);">
              🧘 마음
            </div>
            <div class="habit-edit-cat-btn" onclick="selectHabitEditCategory(this)" data-cat="성장"
              style="padding:6px 4px;background:var(--bg2);border:1.5px solid var(--border);
                     border-radius:var(--radius-sm);text-align:center;cursor:pointer;
                     font-size:11px;font-weight:700;color:var(--text2);">
              🌱 성장
            </div>
          </div>
          <div style="display:flex;gap:6px;">
            <button onclick="cancelHabitEdit()"
              class="btn btn-ghost btn-sm" style="flex:1;">취소</button>
            <button onclick="confirmHabitEdit()"
              class="btn btn-accent btn-sm" style="flex:2;">수정 완료</button>
          </div>
        </div>

        <button onclick="closeHabitModal()" class="btn btn-ghost" style="width:100%;">닫기</button>
      </div>

    </div>
  </div>
</div>
