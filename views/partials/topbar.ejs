<div class="global-header" id="global-header">
  <div class="gh-left">
    <!-- 💡 사이드바 토글 버튼 (toggleSidebar 함수 연결) -->
    <button class="gh-hamburger" onclick="toggleSidebar()" aria-label="메뉴">
      <div class="gh-hamburger-icon" id="hamburger-icon">
        <span></span><span></span><span></span>
      </div>
    </button>
    <!-- AcadMe 로고 (클릭 시 홈 이동) -->
    <div class="gh-logo" onclick="location.href='/home'" style="cursor: pointer;">
      <div class="gh-logo-icon">A</div>
      <span class="gh-logo-text">AcadMe</span>
    </div>
  </div>

<div class="gh-center">
    <% if (typeof pageTitle !== 'undefined' && pageTitle === '공지사항') { %>
      <a href="/notice" style="text-decoration: none; color: inherit; cursor: pointer;">
        <span class="gh-title"><%= pageTitle %></span>
      </a>
    <% } else { %>
      <span class="gh-title"><%= pageTitle || '홈' %></span>
    <% } %>
  </div>

  <div class="gh-right">
    <!-- 알림 버튼 -->
    <div class="gh-btn" onclick="document.getElementById('notif-panel')?.classList.toggle('open')">
      🔔
      <% if (typeof notices !== 'undefined' && Array.isArray(notices) && notices.some(n => n.isUrgent === true)) { %>
        <div class="gh-notif-dot"></div>
      <% } %>
    </div>

    <!-- 아바타 (마이페이지 모달 연결) -->
    <div class="gh-avatar" onclick="openMyPageModal()">
      <%= (typeof user !== 'undefined' && user) ? user.name[0] : '김' %>
    </div>
  </div>
</div>

<div id="notif-panel" class="notif-panel">
  <div class="notif-header">
    <span>새로운 알림</span>
    <button onclick="document.getElementById('notif-panel').classList.remove('open')" class="notif-close-btn">닫기</button>
  </div>
  
  <div class="notif-list" id="dynamic-notif-list">
    <p class="notif-empty" style="padding: 20px; text-align: center; color: #94a3b8;">표시할 알림이 없습니다.</p>
  </div>
</div>

<script>
  // 페이지가 로드되면 자동으로 서버에서 가공된 실시간 알림 데이터를 긁어옴
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/api/banner'); 
      const result = await response.json();

      if (result.success && result.liveAlerts) {
        const notifListDiv = document.getElementById('dynamic-notif-list');
        notifListDiv.innerHTML = ''; // "불러오는 중..." 문구 지우기

        const alerts = result.liveAlerts;

        if (alerts.length > 0) {
          alerts.forEach(notice => {
            const notifItem = `
              <div class="notif-item" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f1f5f9; gap: 15px;">
                <span class="notif-icon" style="font-size: 1.3rem;">${notice.icon}</span>
                <div class="notif-content" style="flex: 1;">
                  <p class="notif-text" style="margin: 0; font-size: 0.95rem; color: #1e293b;"><strong>${notice.body}</strong></p>
                  <p class="notif-date" style="margin: 4px 0 0 0; font-size: 0.8rem; color: #94a3b8; font-weight: 600;">${notice.dDayText}</p>
                </div>
              </div>
            `;
            notifListDiv.insertAdjacentHTML('beforeend', notifItem);
          });
        } else {
          notifListDiv.innerHTML = '<p class="notif-empty" style="padding: 20px; text-align: center; color: #94a3b8;">다가오는 일정이 없습니다.</p>';
        }
      }
    } catch (error) {
      console.error("알림 데이터를 가져오는데 실패함:", error);
      document.getElementById('dynamic-notif-list').innerHTML = '<p class="notif-empty" style="padding: 20px; text-align: center; color: #ef4444;">알림 로드 실패</p>';
    }
  });
</script>