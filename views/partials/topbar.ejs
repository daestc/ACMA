<div class="global-header" id="global-header">
  <div class="gh-left">
    <button class="gh-hamburger" onclick="toggleSidebar()" aria-label="메뉴">
      <div class="gh-hamburger-icon" id="hamburger-icon">
        <span></span><span></span><span></span>
      </div>
    </button>
    <% const homeHref = (typeof user !== 'undefined' && user && user.role === 'staff')
      ? '/staff/home'
      : (typeof user !== 'undefined' && user && user.role === 'admin')
        ? '/admin/staff'
        : '/home'; %>
    <div class="gh-logo" onclick="location.href='<%= homeHref %>'" style="cursor: pointer;">
      <div class="gh-logo-icon">A</div>
      <span class="gh-logo-text">AcadMe</span>
    </div>
  </div>

  <div class="gh-center">
    <% if (typeof pageTitle !== 'undefined' && pageTitle === '공지사항') { %>
      <a href="/notice" style="text-decoration: none; color: inherit; cursor: pointer;">
        <span class="gh-title"><%= pageTitle %></span>
      </a>
    <% } else { %>
      <span class="gh-title"><%= pageTitle || '홈' %></span>
    <% } %>
  </div>

  <div class="notification-icon-wrapper" onclick="toggleNotifPanel()" style="position: relative; cursor: pointer;">
    <i class="icon-bell"></i> 🔔
    <span id="notif-badge-dot" class="notification-dot" style="position: absolute; top: -2px; right: -2px; width: 5px; height: 5px; background-color: #ef4444; border-radius: 50%; display: none;"></span>
  </div>

  <div class="gh-avatar" onclick="openMyPageModal()">
    <%= (typeof user !== 'undefined' && user) ? user.name[0] : '김' %>
  </div>
</div>

<div id="notif-panel" class="notif-panel">
  <div class="notif-header">
    <span>새로운 알림</span>
    <button onclick="document.getElementById('notif-panel').classList.remove('open')" class="notif-close-btn">닫기</button>
  </div>

  <div class="notif-list" id="dynamic-notif-list">
    <p class="notif-empty" style="padding: 20px; text-align: center; color: #94a3b8;">표시할 알림이 없습니다.</p>
  </div>
</div>
  <div id="notif-more-btn-container" style="text-align: center; padding: 10px; display: none;">
    <button id="notif-more-btn" onclick="loadMoreNotifs()">더보기 ▾</button>
  </div>
</div>

<script src="/js/notification.js"></script>
