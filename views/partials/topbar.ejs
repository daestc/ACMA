<div class="global-header" id="global-header">
  <div class="gh-left">
    <button class="gh-hamburger" onclick="toggleSidebar()" aria-label="메뉴">
      <div class="gh-hamburger-icon" id="hamburger-icon">
        <span></span><span></span><span></span>
      </div>
    </button>
    <div class="gh-logo" onclick="location.href='/home'" style="cursor: pointer;">
      <div class="gh-logo-icon">A</div>
      <span class="gh-logo-text">AcadMe</span>
    </div>
  </div>

  <div class="gh-center">
    <% if (typeof pageTitle !== 'undefined' && pageTitle === '공지사항') { %>
      <a href="/notice" style="text-decoration: none; color: inherit; cursor: pointer;">
        <span class="gh-title"><%= pageTitle %></span>
      </a>
    <% } else { %>
      <span class="gh-title"><%= pageTitle || '홈' %></span>
    <% } %>
  </div>

  <div class="notification-icon-wrapper" onclick="toggleNotifPanel()" style="position: relative; cursor: pointer;">
    <i class="icon-bell"></i> 🔔
    <span id="notif-badge-dot" class="notification-dot" style="position: absolute; top: -2px; right: -2px; width: 5px; height: 5px; background-color: #ef4444; border-radius: 50%; display: none;"></span>
  </div>

  <div class="gh-avatar" onclick="openMyPageModal()">
    <%= (typeof user !== 'undefined' && user) ? user.name[0] : '김' %>
  </div>
</div>

<div id="notif-panel" class="notif-panel">
  <div class="notif-header">
    <span>새로운 알림</span>
    <button onclick="document.getElementById('notif-panel').classList.remove('open')" class="notif-close-btn">닫기</button>
  </div>
  
  <div class="notif-list" id="dynamic-notif-list">
    <p class="notif-empty" style="padding: 20px; text-align: center; color: #94a3b8;">표시할 알림이 없습니다.</p>
  </div>
  <div id="notif-more-btn-container" style="text-align: center; padding: 10px; display: none;">
    <button id="notif-more-btn" onclick="loadMoreNotifs()">더보기 ▾</button>
  </div>
</div>

<script>
  let allAlerts = []; // 전체 알림 저장할 변수
  let currentPage = 1; 
  let itemsPerPage = 5; // 🎯 [오타 교정] 자바스크립트 표준 카멜케이스로 변수명 통일!


  function createNotifItem(notice) {
    return `
      <div class="notif-item" style="padding: 12px 16px; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem;">
        <div style="font-weight: 600; color: #1e293b; margin-bottom: 2px;">${notice.title || '알림'}</div>
        <div style="font-size: 0.75rem; color: #ef4444; font-weight: bold;">${notice.dDayText || ''}</div>
      </div>
    `;
  }

  // 페이징 처리
  function renderNotifPage(){
    const notifListDiv = document.getElementById('dynamic-notif-list');
    const moreBtnContainer = document.getElementById('notif-more-btn-container');

    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;

    // 5개씩 자르기
    const pageItems = allAlerts.slice(startIndex, endIndex);

    pageItems.forEach(notice => {
      notifListDiv.insertAdjacentHTML('beforeend', createNotifItem(notice));
    });

    // 더보기 버튼 보이기/숨기기
    if (endIndex < allAlerts.length) {
      moreBtnContainer.style.display = "block";
    } else {
      moreBtnContainer.style.display = "none";
    }
  }

  // 더보기 버튼 클릭 시 호출할 함수
  function loadMoreNotifs() {
    currentPage++;
    renderNotifPage();
  }

  // 페이지가 로드되면 자동으로 서버에서 가공된 실시간 알림 데이터를 긁어옴
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // 알림 API 주소 호출!
      const response = await fetch('/notice/urgent'); 
      const result = await response.json();

      // 서버에서 온 데이터 배열 바인딩
      allAlerts = Array.isArray(result) ? result : [];

      const notifListDiv = document.getElementById('dynamic-notif-list');
      notifListDiv.innerHTML = ''; // 기본 문구 초기화

      if (allAlerts.length > 0) {
        currentPage = 1; // 페이지 초기화
        renderNotifPage(); 
           
        // 알림의 제목(title) 또는 고유 ID로 지문 매칭 처리
        const currentAlerts = allAlerts.map(a => a.title).join('|');

        // 브라우저에서 기존에 기억하던 지문 꺼옴
        const lastReadAlerts = localStorage.getItem('last_read_alerts');
        const redDot = document.getElementById('notif-badge-dot'); // 🎯 [교정] ID 선택자로 정확히 저격!

        // ] 사용자가 아직 안 읽은 새로운 알림이 새로 고침 후 유입되었을 때만 점을 켜기
        if (currentAlerts !== lastReadAlerts) {
          if (redDot) redDot.style.display = 'block'; // 빨간점 켜기
        } else {
          if (redDot) redDot.style.display = 'none';  // 읽었던 상태 그대로면 빨간점 끄기
        }
    
      } else {
        notifListDiv.innerHTML = '<p class="notif-empty" style="padding: 20px; text-align: center; color: #94a3b8;">다가오는 일정이 없어요!</p>';
        document.getElementById('notif-more-btn-container').style.display = 'none';
        const redDot = document.getElementById('notif-badge-dot');
        if (redDot) redDot.style.display = 'none';
      }
    } catch (error) {
      console.error("🚨 알림 데이터를 가져오는데 실패함:", error);
      document.getElementById('dynamic-notif-list').innerHTML = '<p class="notif-empty" style="padding: 20px; text-align: center; color: #ef4444;">알림 로드 실패</p>';
    }
  });
  
  // 사용자가 알림 패널 클릭 시 
  function toggleNotifPanel() {
    const panel = document.getElementById('notif-panel');
    if (!panel) return;

    panel.classList.toggle('open'); // 알림창 열고 닫기 토글
    
    // 알림 버튼을 눌러서 창을 열면 '읽음' 상태로  처리
    if (panel.classList.contains('open') && allAlerts.length > 0) {
      const currentAlerts = allAlerts.map(a => a.title).join('|');
      localStorage.setItem('last_read_alerts', currentAlerts); // 현재 알림 지문 로컬스토리지 저장
      
      // 읽었으니까 빨간점 없애기
      const redDot = document.getElementById('notif-badge-dot');
      if (redDot) redDot.style.display = 'none';
    }
  }
</script>