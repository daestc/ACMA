<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head', { title: pageTitle }) %>
	<title>주간 계획</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'careerPlan', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '주간 계획', user: user }) %>

		<div class="page-content">
      <!-- ══ 빈 상태 ══ -->
      <div class="card" id="cp-empty" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:36px;margin-bottom:12px;">📅</div>
        <div style="font-size:16px;font-weight:700;margin-bottom:8px;">이번 주 계획이 아직 없습니다</div>
        <p style="font-size:13px;color:var(--text2);margin-bottom:20px;line-height:1.6;">
          현재 학업·스펙 데이터를 바탕으로 이번 주 학습 계획을 자동으로 만들어드립니다.
        </p>
        <div style="display:flex;gap:8px;justify-content:center;align-items:center;flex-wrap:wrap;">
          <input type="date" id="cp-weekstart" class="input-field" title="계획을 만들 주에 속하는 아무 날짜나 선택 (기본값: 오늘 = 이번 주)">
          <button class="btn btn-accent" onclick="generatePlan()">계획 생성하기</button>
        </div>
      </div>

      <!-- ══ 생성 중 ══ -->
      <div class="card" id="cp-pending" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:14px;color:var(--accent);">계획을 생성하는 중입니다... (최대 1분 소요)</div>
      </div>

      <!-- ══ 생성 실패 ══ -->
      <div class="card" id="cp-failed" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:14px;color:var(--red);" id="cp-failed-msg">생성에 실패했습니다.</div>
        <button class="btn btn-ghost btn-sm" style="margin-top:12px;" onclick="generatePlan()">다시 시도</button>
      </div>

      <!-- ══ 계획 본문 ══ -->
      <div id="cp-plan" style="display:none;">
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <div>
              <span class="card-title" id="cp-range">-</span>
              <div style="font-size:12px;color:var(--text2);margin-top:4px;" id="cp-status-badge"></div>
            </div>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-ghost btn-sm" onclick="redistribute()">재분배</button>
              <button class="btn btn-ghost btn-sm" onclick="generatePlan()">다시 생성</button>
            </div>
          </div>

          <div id="cp-timetable-warning"></div>
          <div id="cp-dist-errors"></div>

          <div class="progress-wrap" style="margin-top:14px;">
            <div class="progress-header"><span class="progress-label">배정 시간</span><span class="progress-value" id="cp-hours">-</span></div>
            <div class="progress-track"><div class="progress-fill fill-blue" id="cp-hours-fill" style="width:0%"></div></div>
          </div>

          <p style="font-size:13px;color:var(--text2);line-height:1.7;margin-top:14px;" id="cp-goal"></p>
        </div>

        <div id="cp-items" style="display:flex;flex-direction:column;gap:10px;"></div>

        <div class="card" style="margin-top:16px;">
          <div class="card-title" style="margin-bottom:14px;">일별 보기</div>
          <div style="overflow-x:auto;">
            <div id="cp-daily" style="display:flex;gap:10px;min-width:820px;"></div>
          </div>
        </div>
      </div>
		</div>

	</main>

	<!-- 모달 -->
	<%- include('../partials/modals/mypage', { user: user }) %>

	<script src="/js/common.js"></script>
	<script src="/js/careerAi.js"></script>
	<script src="/js/careerPlan.js"></script>
</body>

</html>
