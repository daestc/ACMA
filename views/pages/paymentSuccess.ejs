<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('../partials/head') %>
  <title>결제 완료</title>
</head>
<body>

<%- include('../partials/sidebar', { currentPage: 'payment', user }) %>

<main class="main-content">
  <%- include('../partials/topbar', { pageTitle: '결제 완료', user }) %>

  <div class="page-content" style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
    <div style="text-align:center;max-width:400px;">

      <div style="width:72px;height:72px;border-radius:50%;background:#E1F5EE;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 20px;">✓</div>

      <% if (type === 'premium') { %>
        <h2 style="font-size:22px;font-weight:700;margin-bottom:8px;">프리미엄 구독 완료!</h2>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;margin-bottom:6px;">이제 퀴즈·요약을 무제한으로 이용할 수 있습니다.</p>
        <% if (until) { %>
        <p style="font-size:13px;color:var(--text2);margin-bottom:28px;">구독 만료일: <strong style="color:var(--text1);"><%= until %></strong></p>
        <% } %>
      <% } else { %>
        <h2 style="font-size:22px;font-weight:700;margin-bottom:8px;">포인트 충전 완료!</h2>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;margin-bottom:28px;"><strong style="color:#534AB7;"><%= Number(amount).toLocaleString() %>원</strong>이 충전되었습니다.</p>
      <% } %>

      <div style="display:flex;gap:10px;justify-content:center;">
        <a href="/payment" style="padding:12px 24px;border-radius:10px;border:1px solid var(--border);background:var(--bg2);color:var(--text1);font-size:14px;text-decoration:none;">플랜 페이지</a>
        <a href="/home"    style="padding:12px 24px;border-radius:10px;border:none;background:#534AB7;color:#fff;font-size:14px;text-decoration:none;">홈으로</a>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/modals/mypage', { user: user }) %>
<script src="/js/common.js"></script>
</body>
</html>
