<!DOCTYPE html>
<html lang="ko">

<head>
  <%- include('../partials/head') %>
  <title>홈</title>
  <script>
    // 페이지 랜딩시 받은 habitList
    let habits = <%- JSON.stringify(habitList) %>;
  </script>
</head>
<style>
  .dday-card {
    width: 220px !important; 
    height: 140px !important; 
    flex: none !important;   
    display: flex;
    flex-direction: column;
  }
  
  .slider-container .dday-title {
    white-space: normal;
    word-break: keep-all; 
    line-height: 1.4;
  }

  /* 슬라이더 영역이 남은 공간을 꽉 채우도록 설정 */
  .slider-container {
    flex: 1; 
    display: flex;
    align-items: center; 
    width: 100%;
  }

  .slider-container .slider-item {
    display: none; 
    width: 100%;
  }
  .slider-container .slider-item.active {
    display: block; 
    animation: smoothFade 1.2s ease-in-out forwards; 
  }
  
  @keyframes smoothFade {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>

<body>

  <%- include('../partials/sidebar', { currentPage: 'home', user: user }) %>

  <main class="main-content">

    <%- include('../partials/topbar', { pageTitle: '홈', user: user }) %>

    <div class="page-content">
        <!-- 날씨 + 명언 #후순위 -->
        <div class="grid-2" style="margin-bottom:16px;">
          <!-- 날씨 API -->
          <div class="weather-widget">
            <div class="weather-left">
              <div class="temp" id="weather-temp">--°C</div>
              <div class="desc" id="weather-desc">날씨 불러오는 중...</div>
              <div class="location" id="weather-location">📍 위치 확인 중...</div>
              <div class="weather-detail" id="weather-base" style="margin-top:8px;"></div>
            </div>
            <div class="weather-right">
              <div class="weather-icon" id="weather-icon">🌤️</div>
              <div class="weather-detail" id="weather-tomorrow" style="text-align:center;"></div>
            </div>
          </div>
          <!-- 프로필 -->
          <div class="portfolio-banner" onclick="switchPage('mystatus', null)">
            <div class="portfolio-name" id="profile-name">...</div>
            <div class="portfolio-meta" id="profile-meta">...</div>
          </div>
        </div>

        <div class="dday-row">  
          <!-- 자격증 시험 -->
          <div class="dday-card blue auto-slider">
            <div class="dday-label">자격증 시험</div>
            <div class="slider-container">
              <% if (typeof ddayCerts !== 'undefined' && ddayCerts && ddayCerts.length > 0) { %>
                <% ddayCerts.forEach((cert, index) => { %>
                  <div class="slider-item <%= index === 0 ? 'active' : '' %>">
                    <div class="dday-title"><%= cert.title %></div>
                    <div class="dday-count"><%= cert.dDayText %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="slider-item active">
                  <div class="dday-title">등록된 목표 자격증이 없습니다.</div>
                  <div class="dday-count">-</div>
                </div>
              <% } %>
            </div>
          </div>

          <!--  시험 일정 -->
          <div class="dday-card red auto-slider">
            <div class="dday-label">시험 일정</div>
            <div class="slider-container">
              <% if (typeof examSchedules !== 'undefined' && examSchedules.length > 0) { %>
                <% examSchedules.forEach((exam, index) => { %>
                  <div class="slider-item <%= index === 0 ? 'active' : '' %>">
                    <div class="dday-title"><%= exam.title %></div>
                    <div class="dday-count"><%= exam.dDayLabel %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="slider-item active">
                  <div class="dday-title">예정된 시험 일정이 없습니다.</div>
                  <div class="dday-count">-</div>
                </div>
              <% } %>
            </div>
          </div>
          
          <!-- 일반 학사일정 -->
          <div class="dday-card green auto-slider">
            <div class="dday-label">학사 일정</div>
            <div class="slider-container">
              <% if (typeof generalSchedules !== 'undefined' && generalSchedules.length > 0) { %>
                <% generalSchedules.forEach((schedule, index) => { %>
                  <div class="slider-item <%= index === 0 ? 'active' : '' %>">
                    <div class="dday-title"><%= schedule.title %></div>
                    <div class="dday-count"><%= schedule.dDayLabel %></div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="slider-item active">
                  <div class="dday-title">예정된 학사 일정이 없습니다.</div>
                  <div class="dday-count">-</div>
                </div>
              <% } %>
            </div>
          </div>

        </div>

      <!--오늘의 강의 & 할일-->
      <div class="grid-2" style="margin-bottom:16px;">
        <div class="card">
          <div class="card-header">
            <span class="card-title">📋 오늘의 강의 & 할 일</span>
          </div>
          <div class="tabs" style="margin-bottom:14px;">
            <button class="tab-btn active" onclick="switchHomeTodo('lecture',this)">강의 일정</button>
            <button class="tab-btn" onclick="switchHomeTodo('todo',this)">할 일</button>
          </div>
          <div id="ht-lecture"> 
            <div class="check-item">
              <span class="check-text">오늘의 강의 불러오는 중...</span>
            </div>
          </div>
          <div id="ht-todo" style="display:none;">
            <% if(!todoList || todoList.length === 0) { %>
              <div class="check-item todo-exam"><span class="check-text">오늘의 할 일을 추가하세요</span></div>
            <% } else { %>
              <% todoList.forEach(todo => { %>
                <div class="check-item" data-id="<%= todo._id %>">
                  <div class="check-box" onclick="toggleCheck(this)"></div>
                  <span class="check-text"><%= todo.title %></span>
                  <span class="check-time"><%= todo.note %></span>
                </div>
              <% }) %>
            <% } %>
            <span class="card-action" style="bottom: 0;" onclick="openTodoModal()">편집</span>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">📢 최근 공지사항</span>
            <span class="card-action" onclick="switchPage('notice',null)">전체보기</span>
          </div>
          
          <div class="notice-body-container">
            <% if (typeof topNotices !== 'undefined' && topNotices.length > 0) { %>
              <% topNotices.forEach(notice => { %>
                
                <div class="home-notice-item" onclick="switchPage('notice', null)">
                  
                  <div class="home-notice-left">
                    <div class="home-notice-icon-box" style="background: <%= notice.iconBgColor %>;">
                      <%= notice.icon %>
                    </div>
                    <div class="home-notice-content">
                      <div class="home-notice-title"><%= notice.title %></div>
                      <div class="home-notice-meta">
                        <span class="badge <%= notice.categoryBadgeClass %> home-notice-category-badge">
                          <%= notice.categoryName %>
                        </span>
                        <%= notice.formattedDate %>
                      </div>
                    </div>
                  </div>

                  <div class="home-notice-right">
                    <span class="home-notice-dday-badge <%= notice.dDayBadgeClass %>">
                      <%= notice.dDayText %>
                    </span>
                  </div>

                </div>

              <% }) %>
            <% } else { %>
              <div class="notice-empty" style="padding: 30px; text-align: center; color: #94a3b8; font-size: 0.9rem;">
                최근 공지가 없습니다.
              </div>
            <% } %>
          </div>
        </div>
      </div> 
      
      <div class="card">
        <div class="card-header">
          <span class="card-title">🌱 오늘의 습관 트래커</span>
          <div style="display:flex;align-items:center;gap:8px;">
            <span id="habit-summary" style="font-size:12px;color:var(--text2);font-weight:600;"><%= completedCount %> / <%= habitList.length %> 완료</span>
            <button class="btn btn-ghost btn-sm" onclick="openHabitModal()">✏️ 수정</button>
          </div>
        </div>
        <div style="margin-bottom:14px;">
          <div style="height:6px;background:var(--bg4);border-radius:3px;overflow:hidden;">
            <div id="habit-progress-bar" style="height:100%;width:60%;background:linear-gradient(90deg,var(--green),#34d399);border-radius:3px;transition:width .4s ease;"></div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;" id="habit-list">
          <% habitList.forEach(habit => { %>
            <div class="habit-item" data-id="<%= habit._id %>" data-done="<%= habit.isCompleted %>" onclick="toggleHabit(this)">
              <% if(habit.isCompleted) { %>
                <div class="habit-check done">✓</div>
                <div class="habit-body">
                  <div class="habit-name done"><%= habit.title %></div>
              <% } else { %>
                <div class="habit-check"></div>
                <div class="habit-body">
                  <div class="habit-name"><%= habit.title %></div>
              <% } %>
                <div class="habit-sub"><%= habit.category %> · 매일</div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

  </main>

  <%- include('../partials/modals/mypage', { user: user }) %>
  <%- include('../partials/modals/todo_add', { user: user }) %>
  <%- include('../partials/modals/habit_edit') %>

  <script src="/js/common.js"> </script>
  <script src="/js/location.js"> </script>
  <script src="/js/weather.js"> </script>
  <script src="/js/home.js"> </script>

</body>

</html>