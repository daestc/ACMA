<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>진로정보</title>
</head>

<body>
	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'career', user: user }) %>
	<main class="main-content">
		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '진로정보', user: user }) %>
		<div class="page-content">
    <!-- ══ CAREER (진로정보) ══ -->
    <div class="page-content">
        <div class="tabs">
          <button class="tab-btn active" onclick="switchCareerTab('cert',this)">자격증 정보</button>
          <button class="tab-btn" onclick="switchCareerTab('job',this)">직무 정보</button>
        </div>
        <!-- 자격증 -->
        <div id="ca-cert">
          <!-- 현재 선택한 자격증 목록 -->
          <div id="my-cert-list" class="my-cert-list">
            <div class="career-empty-state">현재 선택한 자격증을 불러오는 중입니다.</div>
          </div>
          <!-- 자격증 검색 -->
          <div class="cert-search-box">
            <div class="cert-search-title">자격증 카테고리 검색</div>
            <div class="cert-search-dropdowns">
              <select id="cert_depth1" class="select-field">
                <option value="">대분류 선택</option>
              </select>
              <select id="cert_depth2" class="select-field">
                <option value="">중분류 선택</option>
              </select>
              <select id="cert_depth3" class="select-field">
                <option value="">등급 선택</option>
              </select>
            </div>
            <div id="cert-search-meta" class="cert-search-meta"></div>
            <div class="cert-search-bottom">
              <input id="cert-search-keyword" class="input-field" placeholder="자격증명, 키워드를 입력하세요 (예: 정보처리, SQL)" style="flex:1;">
              <button id="cert-search-btn" class="btn btn-accent" style="padding:11px 18px;font-weight:700;white-space:nowrap;">검색</button>
            </div>
          </div>
          <!-- 검색 결과 -->
          <div id="cert-search-results" class="career-search-results" style="display:none;">
            <div class="career-search-head">
              <div id="cert-search-title" class="career-search-title">검색 결과</div>
              <div id="cert-search-count" class="career-search-count"></div>
            </div>
            <div id="cert-search-list" class="career-search-list grid-3"></div>
            <div class="career-search-footer">
              <div id="cert-search-page-info" class="career-search-page-info"></div>
              <div id="cert-search-pagination" class="career-search-pagination"></div>
            </div>
          </div>
        </div>
        <!-- 직무 정보 -->
        <div id="ca-job" style="display:none;">
          <!-- 현재 선택한 직무 -->
          <div id="my-job-info" class="my-job-info">
            <div class="career-empty-state">현재 선택한 직무를 불러오는 중입니다.</div>
          </div>
          <!-- 분류 검색 -->
          <div class="job-search-box">
            <div class="job-search-title">직무 카테고리 검색</div>
            <div class="job-search-dropdowns">
              <select id="depth1" class="select-field" style="width:100%;">
                <option value="">대분류 선택</option>
              </select>
              <select id="depth2" class="select-field" style="width:100%;">
                <option value="">중분류 선택</option>
              </select>
              <select id="depth3" class="select-field" style="width:100%;">
                <option value="">소분류 선택</option>
              </select>
              <select id="depth4" class="select-field" style="width:100%;">
                <option value="">세분류 선택</option>
              </select>
            </div>
            <div id="career-search-meta" class="career-search-meta"></div>
            <div class="job-search-bottom">
              <input id="career-search-keyword" class="input-field" placeholder="직무명, 키워드를 입력하세요 (예: 데이터, 웹)" style="flex:1;">
              <button id="career-search-btn" class="btn btn-accent">검색</button>
            </div>
          </div>
          <!-- 검색 결과 -->
          <div id="career-search-results" class="career-search-results" style="display:none;">
            <div class="career-search-head">
              <div id="career-search-title" class="career-search-title">검색 결과</div>
              <div id="career-search-count" class="career-search-count"></div>
            </div>
            <div id="career-search-list" class="career-search-list"></div>
            <div class="career-search-footer">
              <div id="career-search-page-info" class="career-search-page-info"></div>
              <div id="career-search-pagination" class="career-search-pagination"></div>
            </div>
          </div>
        </div>
      </div>
		</div>
	</main>
	<!-- 모달 -->
  <%- include('../partials/modals/cert_detail') %>
	<%- include('../partials/modals/job_detail') %>
	<%- include('../partials/modals/mypage', { user: user }) %>

	<script src="/js/common.js"></script>
	<script src="/js/career.js"></script>
</body>

</html>