<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %></title>
  <style>
    .plan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }
    .plan-card {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      background: white;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .plan-card.current {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }
    .plan-card.featured {
      border-color: #7c3aed;
      box-shadow: 0 8px 24px rgba(124, 58, 237, 0.12);
    }
    .plan-price {
      font-size: 28px;
      font-weight: 800;
      font-family: 'DM Sans', sans-serif;
    }
    .plan-feature {
      font-size: 13px;
      color: var(--text2);
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .usage-box {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 8px;
    }
    .usage-bar {
      height: 10px;
      background: var(--bg3);
      border-radius: 999px;
      overflow: hidden;
      margin-top: 10px;
    }
    .usage-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), #7c3aed);
      border-radius: 999px;
      transition: width .3s ease;
    }
  </style>
</head>
<body>
  <%- include('../partials/sidebar', { currentPage, user }) %>

  <main class="main-content">
    <%- include('../partials/topbar', { pageTitle, user }) %>

    <div class="page-content">
      <div class="usage-box">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
          <div>
            <div style="font-size:13px;color:var(--text2);">현재 플랜</div>
            <div style="font-size:20px;font-weight:800;margin-top:4px;">
              <%= status.planName %>
              <% if (status.isPaid) { %><span class="badge badge-purple" style="margin-left:8px;">유료</span><% } %>
            </div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:13px;color:var(--text2);">이번 달 AI 사용량</div>
            <div style="font-size:18px;font-weight:700;margin-top:4px;">
              <span id="ai-used-count"><%= status.aiUsed %></span> / <span id="ai-limit-count"><%= status.aiLimit %></span>회
            </div>
          </div>
        </div>
        <div class="usage-bar">
          <div id="ai-usage-bar" class="usage-bar-fill" style="width:<%= Math.min(100, Math.round((status.aiUsed / status.aiLimit) * 100)) %>%"></div>
        </div>
        <div style="font-size:12px;color:var(--text2);margin-top:8px;">
          <%= status.periodKey %> 기준 · 세션에 저장 (DB 미연동)
        </div>
      </div>

      <% if (!hasTossKey) { %>
        <div class="card" style="padding:16px 18px;margin-bottom:16px;border-color:#f59e0b;background:#fffbeb;">
          <div style="font-size:14px;font-weight:700;color:#b45309;">토스페이먼츠 키 미설정</div>
          <div style="font-size:13px;color:#92400e;margin-top:6px;line-height:1.5;">
            `.env`에 <code>TOSS_CLIENT_KEY</code>, <code>TOSS_SECRET_KEY</code>를 추가해주세요.
            테스트 키는 <a href="https://docs.tosspayments.com/reference" target="_blank" rel="noopener">토스페이먼츠 개발자센터</a>에서 확인할 수 있습니다.
          </div>
        </div>
      <% } %>

      <div class="plan-grid">
        <% Object.values(plans).forEach(plan => { %>
          <div class="plan-card <%= status.plan === plan.id ? 'current' : '' %> <%= plan.id === 'pro' ? 'featured' : '' %>">
            <div>
              <div style="font-size:12px;color:var(--text2);font-weight:700;"><%= plan.label %></div>
              <div class="plan-price" style="margin-top:8px;">
                <% if (plan.price === 0) { %>무료<% } else { %>₩<%= plan.price.toLocaleString('ko-KR') %><span style="font-size:14px;font-weight:600;color:var(--text2);">/월</span><% } %>
              </div>
              <div style="font-size:13px;color:var(--text2);margin-top:6px;"><%= plan.description %></div>
            </div>

            <div>
              <% plan.features.forEach(feature => { %>
                <div class="plan-feature">✓ <%= feature %></div>
              <% }) %>
            </div>

            <% if (status.plan === plan.id) { %>
              <button class="btn btn-ghost btn-sm" disabled style="width:100%;justify-content:center;">현재 이용 중</button>
            <% } else if (plan.id === 'free') { %>
              <button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;" onclick="cancelSubscription()">무료로 변경</button>
            <% } else { %>
              <button class="btn btn-accent btn-sm" style="width:100%;justify-content:center;" onclick="startCheckout('<%= plan.id %>')" <%= !hasTossKey ? 'disabled' : '' %>>
                <%= plan.label %> 구독하기
              </button>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div class="card" style="margin-top:20px;padding:18px 20px;">
        <div style="font-size:14px;font-weight:700;margin-bottom:8px;">AI 한도 테스트</div>
        <div style="font-size:13px;color:var(--text2);margin-bottom:12px;">구독 후 AI 기능 사용 시 한도가 차감됩니다. (현재는 테스트 버튼)</div>
        <button class="btn btn-ghost btn-sm" onclick="testAiUse()">AI 1회 사용 테스트</button>
        <div id="sub-msg" style="display:none;margin-top:12px;font-size:12px;padding:10px 12px;border-radius:8px;"></div>
      </div>
    </div>
  </main>

  <%- include('../partials/modals/mypage', { user: user }) %>
  <script src="https://js.tosspayments.com/v2/standard"></script>
  <script src="/js/common.js"></script>
  <script src="/js/subscription.js"></script>
</body>
</html>
