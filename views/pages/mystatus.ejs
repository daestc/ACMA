<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>MyStatus</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'mystatus', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: 'MyStatus', user: user }) %>

		<div class="page-content">
    <!-- ══ MYSTATUS ══ -->
    <div class="page-content">

        <!-- 사람인 포트폴리오 배너 -->
        <div class="portfolio-banner">
          <div class="portfolio-name" id="profile-name">...</div>
          <div class="portfolio-meta" id="profile-meta">...</div>
          <div class="portfolio-tags">
            <span class="portfolio-tag" id="profile-job">...</span>
            <span class="portfolio-tag" id="profile-certification">...</span>
          </div>
        </div>

        <!-- ① 학업 현황 요약 통계 카드 (홈에서 이동) -->
        <div class="grid-4" style="margin-bottom:16px;">
          <div class="stat-card blue"><div class="stat-icon">📊</div><div class="stat-label">현재 평점</div><div class="stat-value" id="credit-avg">...</div></div>
          <div class="stat-card green"><div class="stat-icon">📚</div><div class="stat-label">이수 학점</div><div class="stat-value" id="credit-earned">...</div></div>
          <div class="stat-card amber"><div class="stat-icon">📝</div><div class="stat-label">이번 주 목표달성</div><div class="stat-value" id="study-time">...</div></div>
          <div class="stat-card purple"><div class="stat-icon">🏅</div><div class="stat-label">취득 자격증</div><div class="stat-value" id="certificates">...</div></div>
        </div>

        <!-- ② 이수 현황 (학사관리에서 이동) -->
        <!-- 영역별 이수 현황 + 학기별 성적 이력 -->
          <div class="grid-2">
            <div class="card">
                <div class="card-title" style="margin-bottom:16px;"> 영역별 이수 현황</div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공필수</span><span id="pv-major-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-req" class="progress-fill fill-blue" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공선택</span><span id="pv-major-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-el" class="progress-fill fill-purple" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양필수</span><span id="pv-gen-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-req" class="progress-fill fill-green" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양선택</span><span id="pv-gen-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-el" class="progress-fill fill-amber" style="width:0%"></div></div></div>
                <div class="progress-wrap" style="margin-bottom:0;"><div class="progress-header"><span class="progress-label">총 이수 학점</span><span id="pv-total" class="progress-value">-</span></div><div class="progress-track" style="height:10px;"><div id="pf-total" class="progress-fill fill-blue" style="width:0%"></div></div></div>
            </div>
          <div class="card">
              <div class="card-title" style="margin-bottom:14px;"> 학기별 성적 이력</div>
              <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;">
                  <thead>
                    <tr style="border-bottom:2px solid var(--border);">
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">학기</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">이수학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">취득학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">GPA</th>
                    </tr>
                  </thead>
                  <tbody id="semester-gpa-history-body">
                    <tr>
                      <td colspan="4" style="padding:14px 10px;font-size:13px;color:var(--text2);text-align:center;">학기별 데이터를 불러오는 중...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:20px;">
                <div style="text-align:center;">
                  <div id="semester-gpa-average" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--accent);">-</div>
                  <div style="font-size:11px;color:var(--text2);">누적 평점</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-best" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--green);">-</div>
                  <div style="font-size:11px;color:var(--text2);">최고 학기</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-count" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--purple);">-</div>
                  <div style="font-size:11px;color:var(--text2);">총 취득 학점</div>
                </div>
              </div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:16px;"></div>
        <div class="grid-2" style="margin-bottom:16px;">
          <!-- 자격증 / 대외활동 / 어학성적 탭 -->
          <div class="card">
            <div class="tabs" style="margin-bottom:14px;">
              <button class="tab-btn active" onclick="switchStatusTab('cert',this)">자격증</button>
              <button class="tab-btn" onclick="switchStatusTab('activity',this)">대외활동</button>
              <button class="tab-btn" onclick="switchStatusTab('lang',this)">어학성적</button>
            </div>
            <div id="st-cert">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏅 자격증</span><span class="card-action">+ 추가</span></div>
              <div class="cert-item"><div class="cert-icon">📋</div><div class="cert-name">정보처리기사</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2025.06</span></div>
              <div class="cert-item"><div class="cert-icon">🖥️</div><div class="cert-name">SQLD</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2024.12</span></div>
              <div class="cert-item"><div class="cert-icon">🌐</div><div class="cert-name">TOEIC</div><span class="badge badge-amber">준비중</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">목표 650</span></div>
              <div class="cert-item"><div class="cert-icon">☁️</div><div class="cert-name">AWS SAA</div><span class="badge badge-blue">목표</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2026.08</span></div>
            </div>
            <div id="st-activity" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏆 수상 및 대외활동</span><span class="card-action">+ 추가</span></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--accent);"></div><div class="activity-body"><div class="activity-title">교내 해커톤 최우수상</div><div class="activity-meta">한국대학교 · 2025.11 · 교내</div></div></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--green);"></div><div class="activity-body"><div class="activity-title">SW 마에스트로 13기 수료</div><div class="activity-meta">과학기술정보통신부 · 2025.08 · 대외</div></div></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--amber);"></div><div class="activity-body"><div class="activity-title">오픈소스 기여 활동</div><div class="activity-meta">GitHub · 2025.03 ~ 현재 · 대외</div></div></div>
            </div>
            <div id="st-lang" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🌍 어학 성적</span><span class="card-action">+ 추가</span></div>
              <div class="cert-item"><div class="cert-icon" style="background:var(--sky-bg);">🇺🇸</div><div class="cert-name">TOEIC</div><span class="badge badge-amber">준비중</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">목표 650점</span></div>
              <div class="cert-item"><div class="cert-icon" style="background:var(--green-bg);">🇯🇵</div><div class="cert-name">JLPT N3</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2024.07</span></div>
              <div style="margin-top:12px;padding:12px;background:var(--bg3);border-radius:var(--radius-sm);border:1px dashed var(--border2);"><div style="font-size:12px;color:var(--text2);font-weight:500;">+ 성적 추가하기 (IELTS, TOEFL, HSK 등)</div></div>
            </div>
          </div>

          <!-- AI 로드맵 -->
          <div class="card">
            <div class="card-header"><span class="card-title">🤖 AI 추천 커리어 로드맵</span><span class="badge badge-blue">백엔드 개발자</span></div>
            <div class="roadmap">
              <div class="roadmap-item done"><div class="roadmap-title">기초 CS 지식 강화</div><div class="roadmap-desc">자료구조, 알고리즘, 운영체제 이수</div></div>
              <div class="roadmap-item done"><div class="roadmap-title">데이터베이스 자격증</div><div class="roadmap-desc">SQLD 취득 완료</div></div>
              <div class="roadmap-item current"><div class="roadmap-title">클라우드 역량 강화</div><div class="roadmap-desc">AWS SAA 준비 중 · 현재 단계</div></div>
              <div class="roadmap-item"><div class="roadmap-title">실무 프로젝트 경험</div><div class="roadmap-desc">인턴십 또는 팀 프로젝트 참여</div></div>
              <div class="roadmap-item"><div class="roadmap-title">포트폴리오 완성 및 취업</div><div class="roadmap-desc">GitHub 정리, 이력서 작성, 채용 지원</div></div>
            </div>
          </div>
        </div>

        <!-- 스킬 (보유 능력) -->
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <span class="card-title">⚡ 스킬 (보유 능력)</span>
            <button class="btn btn-ghost btn-sm">+ 스킬 추가</button>
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <!-- 카테고리별 스킬 그룹 -->
            <div>
              <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;">언어</div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <div class="skill-tag" style="--lv:#3d5af1;">Java <span class="skill-lv" style="color:#3d5af1;">고급</span></div>
                <div class="skill-tag" style="--lv:#3d5af1;">JavaScript <span class="skill-lv" style="color:#3d5af1;">고급</span></div>
                <div class="skill-tag" style="--lv:#059669;">Python <span class="skill-lv" style="color:#059669;">중급</span></div>
                <div class="skill-tag" style="--lv:#d97706;">C++ <span class="skill-lv" style="color:#d97706;">입문</span></div>
              </div>
            </div>
            <div>
              <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;">프레임워크 & 라이브러리</div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <div class="skill-tag">Spring Boot <span class="skill-lv" style="color:#3d5af1;">고급</span></div>
                <div class="skill-tag">Node.js <span class="skill-lv" style="color:#059669;">중급</span></div>
                <div class="skill-tag">React <span class="skill-lv" style="color:#059669;">중급</span></div>
                <div class="skill-tag">JPA/Hibernate <span class="skill-lv" style="color:#059669;">중급</span></div>
              </div>
            </div>
            <div>
              <div style="font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;">데이터베이스 & 도구</div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                <div class="skill-tag">MySQL <span class="skill-lv" style="color:#3d5af1;">고급</span></div>
                <div class="skill-tag">MongoDB <span class="skill-lv" style="color:#059669;">중급</span></div>
                <div class="skill-tag">Redis <span class="skill-lv" style="color:#d97706;">입문</span></div>
                <div class="skill-tag">Git <span class="skill-lv" style="color:#3d5af1;">고급</span></div>
                <div class="skill-tag">Docker <span class="skill-lv" style="color:#059669;">중급</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 경험 / 활동 / 교육 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">🗂 경험 / 활동 / 교육</span>
            <div style="display:flex;gap:6px;">
              <div class="tabs" style="margin-bottom:0;">
                <button class="tab-btn active" onclick="switchExpTab('work',this)">경험</button>
                <button class="tab-btn" onclick="switchExpTab('activity',this)">활동</button>
                <button class="tab-btn" onclick="switchExpTab('education',this)">교육</button>
              </div>
              <button class="btn btn-ghost btn-sm">+ 추가</button>
            </div>
          </div>

          <!-- 경험 탭 -->
          <div id="exp-work">
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--accent);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                  <div>
                    <div class="exp-title">카카오 서버 개발 인턴십</div>
                    <div class="exp-meta">카카오 · 검색플랫폼팀 · 백엔드 인턴 · hybrid</div>
                    <div class="exp-period">2025.07 ~ 2025.08 · 2개월</div>
                  </div>
                  <div style="display:flex;gap:4px;flex-shrink:0;">
                    <span class="badge badge-blue">Java</span>
                    <span class="badge badge-blue">Spring</span>
                    <span class="badge badge-sky">Redis</span>
                  </div>
                </div>
                <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px;">
                  <div class="exp-ach">• API 응답속도 40% 개선 — 평균 320ms → 190ms</div>
                  <div class="exp-ach">• 신규 검색 필터 API 3개 개발</div>
                </div>
              </div>
            </div>
            <div class="exp-item" style="border-bottom:none;">
              <div class="exp-dot" style="background:var(--purple);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                  <div>
                    <div class="exp-title">교내 해커톤 프로젝트 — 학사관리 앱</div>
                    <div class="exp-meta">한국대학교 · 팀 프로젝트 (4인)</div>
                    <div class="exp-period">2025.11 · 2박 3일</div>
                  </div>
                  <div style="display:flex;gap:4px;flex-shrink:0;">
                    <span class="badge badge-purple">Node.js</span>
                    <span class="badge badge-blue">React</span>
                  </div>
                </div>
                <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px;">
                  <div class="exp-ach">• 최우수상 수상</div>
                  <div class="exp-ach">• 백엔드 API 및 DB 설계 담당</div>
                </div>
              </div>
            </div>
          </div>

          <!-- 활동 탭 -->
          <div id="exp-activity" style="display:none;">
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--green);"></div>
              <div class="exp-body">
                <div class="exp-title">SW 마에스트로 13기</div>
                <div class="exp-meta">과학기술정보통신부 · 대외활동</div>
                <div class="exp-period">2025.04 ~ 2025.08 · 5개월</div>
                <div class="exp-ach" style="margin-top:6px;">• 팀 프로젝트 리더로 서비스 기획 및 출시</div>
              </div>
            </div>
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--accent);"></div>
              <div class="exp-body">
                <div class="exp-title">멋쟁이사자처럼 12기</div>
                <div class="exp-meta">한국대학교 · 동아리 · 기술 멘토</div>
                <div class="exp-period">2025.03 ~ 현재 진행 중</div>
                <div class="exp-ach" style="margin-top:6px;">• 30명 대상 Node.js 세션 진행 (4회)</div>
              </div>
            </div>
            <div class="exp-item" style="border-bottom:none;">
              <div class="exp-dot" style="background:var(--amber);"></div>
              <div class="exp-body">
                <div class="exp-title">오픈소스 기여 (GitHub)</div>
                <div class="exp-meta">대외활동</div>
                <div class="exp-period">2025.03 ~ 현재 진행 중</div>
                <div class="exp-ach" style="margin-top:6px;">• Spring Boot 이슈 수정 PR 2건 merge</div>
              </div>
            </div>
          </div>

          <!-- 교육 탭 -->
          <div id="exp-education" style="display:none;">
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--sky);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                  <div>
                    <div class="exp-title">실전 Spring Boot — 인프런</div>
                    <div class="exp-meta">인프런 · 온라인 강의 · 김영한 강사</div>
                    <div class="exp-period">2025.09 ~ 2025.10 · 수료</div>
                  </div>
                  <span class="badge badge-green">수료</span>
                </div>
              </div>
            </div>
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--amber);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                  <div>
                    <div class="exp-title">AWS Solutions Architect 준비 과정</div>
                    <div class="exp-meta">패스트캠퍼스 · 온라인 강의</div>
                    <div class="exp-period">2026.02 ~ 현재 · 수강중</div>
                  </div>
                  <span class="badge badge-amber">수강중</span>
                </div>
              </div>
            </div>
            <div class="exp-item" style="border-bottom:none;">
              <div class="exp-dot" style="background:var(--green);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                  <div>
                    <div class="exp-title">한국대학교 컴퓨터공학과</div>
                    <div class="exp-meta">대학교 · 주전공 · 3학년 재학 중</div>
                    <div class="exp-period">2021.03 ~ 현재</div>
                  </div>
                  <span class="badge badge-green">재학중</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ④ 활동 히스토리 및 통계 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">📈 활동 히스토리 및 통계</span>
            <div class="tabs" style="margin-bottom:0;">
              <button class="tab-btn active" id="hist-tab-study" onclick="switchHistTab('study',this)">공부 기록</button>
              <button class="tab-btn" id="hist-tab-quiz" onclick="switchHistTab('quiz',this)">퀴즈 기록</button>
              <button class="tab-btn" id="hist-tab-login" onclick="switchHistTab('login',this)">로그인 기록</button>
            </div>
          </div>

          <!-- 공부 기록 -->
          <div id="hist-study">
            <div class="grid-2" style="gap:16px;">
              <div>
                <div style="font-size:12px;font-weight:700;color:var(--text2);margin-bottom:10px;">이번 주 일별 공부 시간</div>
                <div class="study-bars">
                  <div class="study-bar-wrap"><div class="study-bar" style="height:35%;"></div><div class="study-bar-label">월</div></div>
                  <div class="study-bar-wrap"><div class="study-bar" style="height:80%;"></div><div class="study-bar-label">화</div></div>
