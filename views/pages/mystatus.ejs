<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>MyStatus</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'mystatus', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: 'MyStatus', user: user }) %>

		<div class="page-content">
    <!-- ══ MYSTATUS ══ -->
    <div class="page-content">

        <!-- 사람인 포트폴리오 배너 -->
        <div class="portfolio-banner">
          <div class="portfolio-name">김민준</div>
          <div class="portfolio-meta">한국대학교 컴퓨터공학과 3학년 · GPA 3.80 / 4.5 · 이수 92학점</div>
          <div class="portfolio-tags">
            <span class="portfolio-tag">백엔드 개발자 목표</span>
            <span class="portfolio-tag">정보처리기사 취득</span>
            <span class="portfolio-tag">SQLD 취득</span>
            <span class="portfolio-tag">TOEIC 준비중</span>
          </div>
        </div>

        <!-- ① 학업 현황 요약 통계 카드 (홈에서 이동) -->
        <div class="grid-4" style="margin-bottom:16px;">
          <div class="stat-card blue"><div class="stat-icon">📊</div><div class="stat-label">현재 평점</div><div class="stat-value">3.8</div><div class="stat-sub">/ 4.5 만점</div></div>
          <div class="stat-card green"><div class="stat-icon">📚</div><div class="stat-label">이수 학점</div><div class="stat-value">92</div><div class="stat-sub">/ 130 학점</div></div>
          <div class="stat-card amber"><div class="stat-icon">📝</div><div class="stat-label">이번 주 공부</div><div class="stat-value">14h</div><div class="stat-sub">목표: 20h</div></div>
          <div class="stat-card purple"><div class="stat-icon">🏅</div><div class="stat-label">취득 자격증</div><div class="stat-value">3</div><div class="stat-sub">목표: 5개</div></div>
        </div>

        <div class="grid-2" style="margin-bottom:16px;">
          <!-- 레이더 차트 (NCS API 기반) -->
          <div class="card">
            <div class="card-header">
              <span class="card-title">직무 역량 레이더</span>
              <span class="badge badge-sky">NCS 기반</span>
            </div>
            <div style="display:flex;align-items:center;justify-content:center;">
              <svg width="260" height="240" viewBox="0 0 260 240">
                <defs><radialGradient id="rg" cx="50%" cy="50%"><stop offset="0%" stop-color="#3d5af1" stop-opacity=".2"/><stop offset="100%" stop-color="#3d5af1" stop-opacity=".03"/></radialGradient></defs>
                <polygon points="130,20 210,72 210,162 130,214 50,162 50,72" fill="none" stroke="#e3e6f0" stroke-width="1.5"/>
                <polygon points="130,45 196,86 196,149 130,191 64,149 64,86" fill="none" stroke="#e3e6f0" stroke-width="1"/>
                <polygon points="130,70 182,100 182,136 130,168 78,136 78,100" fill="none" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="130" y2="20" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="210" y2="72" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="210" y2="162" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="130" y2="214" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="50" y2="162" stroke="#e3e6f0" stroke-width="1"/>
                <line x1="130" y1="117" x2="50" y2="72" stroke="#e3e6f0" stroke-width="1"/>
                <polygon points="130,37 197,84 197,158 130,186 74,152 60,86" fill="url(#rg)" stroke="#3d5af1" stroke-width="2"/>
                <circle cx="130" cy="37" r="4" fill="#3d5af1"/><circle cx="197" cy="84" r="4" fill="#3d5af1"/>
                <circle cx="197" cy="158" r="4" fill="#3d5af1"/><circle cx="130" cy="186" r="4" fill="#3d5af1"/>
                <circle cx="74" cy="152" r="4" fill="#3d5af1"/><circle cx="60" cy="86" r="4" fill="#3d5af1"/>
                <text x="130" y="12" text-anchor="middle" fill="#5a6080" font-size="11" font-family="Noto Sans KR">전공지식</text>
                <text x="224" y="72" text-anchor="start" fill="#5a6080" font-size="11" font-family="Noto Sans KR">문제해결</text>
                <text x="224" y="168" text-anchor="start" fill="#5a6080" font-size="11" font-family="Noto Sans KR">커뮤니케이션</text>
                <text x="130" y="230" text-anchor="middle" fill="#5a6080" font-size="11" font-family="Noto Sans KR">리더십</text>
                <text x="36" y="168" text-anchor="end" fill="#5a6080" font-size="11" font-family="Noto Sans KR">창의성</text>
                <text x="36" y="72" text-anchor="end" fill="#5a6080" font-size="11" font-family="Noto Sans KR">협업</text>
              </svg>
            </div>
          </div>

          <!-- 졸업 요건 -->
          <div class="card">
            <div class="card-header"><span class="card-title">🎓 졸업 요건</span><span class="badge badge-amber">70%</span></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공필수</span><span class="progress-value">32/42학점</span></div><div class="progress-track"><div class="progress-fill fill-blue" style="width:76%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공선택</span><span class="progress-value">28/40학점</span></div><div class="progress-track"><div class="progress-fill fill-purple" style="width:70%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양필수</span><span class="progress-value">18/20학점</span></div><div class="progress-track"><div class="progress-fill fill-green" style="width:90%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양선택</span><span class="progress-value">14/28학점</span></div><div class="progress-track"><div class="progress-fill fill-amber" style="width:50%"></div></div></div>
            <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;">
              <span class="badge badge-green">✓ 졸업작품</span>
              <span class="badge badge-red">✗ TOEIC</span>
              <span class="badge badge-amber">~ 정보처리기사</span>
            </div>
          </div>
        </div>

        <!-- ② 이수 현황 (학사관리에서 이동) -->
        <div class="grid-2" style="margin-bottom:16px;">
          <div class="card">
            <div class="card-header"><span class="card-title">📂 영역별 이수 현황</span><span style="font-size:12px;color:var(--text2);">총 92 / 130학점</span></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공필수</span><span class="progress-value">32/42</span></div><div class="progress-track"><div class="progress-fill fill-blue" style="width:76%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공선택</span><span class="progress-value">28/40</span></div><div class="progress-track"><div class="progress-fill fill-purple" style="width:70%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양필수</span><span class="progress-value">18/20</span></div><div class="progress-track"><div class="progress-fill fill-green" style="width:90%"></div></div></div>
            <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양선택</span><span class="progress-value">14/28</span></div><div class="progress-track"><div class="progress-fill fill-amber" style="width:50%"></div></div></div>
            <div class="progress-wrap" style="margin-bottom:0;"><div class="progress-header"><span class="progress-label">총 이수 학점</span><span class="progress-value">92/130</span></div><div class="progress-track" style="height:10px;"><div class="progress-fill fill-blue" style="width:71%"></div></div></div>
          </div>
          <div class="card">
            <div class="card-title" style="margin-bottom:14px;">📅 학기별 성적 이력</div>
            <div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;">
              <thead><tr style="border-bottom:2px solid var(--border);">
                <th style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;padding:8px 10px;text-align:left;">학기</th>
                <th style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;padding:8px 10px;text-align:left;">이수</th>
                <th style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;padding:8px 10px;text-align:left;">취득</th>
                <th style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;padding:8px 10px;text-align:left;">GPA</th>
              </tr></thead>
              <tbody>
                <tr style="border-bottom:1px solid var(--border);"><td style="padding:9px 10px;">2024-1</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;"><strong style="color:var(--green);">3.92</strong></td></tr>
                <tr style="border-bottom:1px solid var(--border);"><td style="padding:9px 10px;">2024-2</td><td style="padding:9px 10px;">21</td><td style="padding:9px 10px;">21</td><td style="padding:9px 10px;"><strong style="color:var(--accent);">3.75</strong></td></tr>
                <tr style="border-bottom:1px solid var(--border);"><td style="padding:9px 10px;">2025-1</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;"><strong style="color:var(--green);">4.10</strong></td></tr>
                <tr style="border-bottom:1px solid var(--border);"><td style="padding:9px 10px;">2025-2</td><td style="padding:9px 10px;">21</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;"><strong style="color:var(--amber);">3.55</strong></td></tr>
                <tr><td style="padding:9px 10px;">2026-1</td><td style="padding:9px 10px;">18</td><td style="padding:9px 10px;">-</td><td style="padding:9px 10px;"><span class="badge badge-blue">진행중</span></td></tr>
              </tbody>
            </table></div>
          </div>
        </div>

        <!-- ③ 직무 적합도 그래프 -->
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <span class="card-title">💼 직무 적합도 분석 — 백엔드 개발자</span>
            <span class="badge badge-blue">내 프로필 기반</span>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;">
            <!-- 도넛 차트 + 총점 -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
              <div style="position:relative;width:160px;height:160px;">
                <svg width="160" height="160" viewBox="0 0 160 160">
                  <circle cx="80" cy="80" r="60" fill="none" stroke="#e5e8f0" stroke-width="18"/>
                  <!-- 78% arc: 2πr * 0.78 ≈ 293.8, 총 둘레 2π*60≈376.9 -->
                  <circle cx="80" cy="80" r="60" fill="none" stroke="#3d5af1" stroke-width="18"
                    stroke-dasharray="293 377" stroke-dashoffset="94" stroke-linecap="round"
                    style="transform:rotate(-90deg);transform-origin:80px 80px;transition:stroke-dasharray 1s ease;"/>
                </svg>
                <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                  <div style="font-size:30px;font-weight:800;font-family:'DM Sans';color:var(--accent);">78%</div>
                  <div style="font-size:11px;color:var(--text2);font-weight:600;">종합 적합도</div>
                </div>
              </div>
              <div style="text-align:center;">
                <div style="font-size:13px;font-weight:700;color:var(--text);">백엔드 개발자</div>
                <div style="font-size:11px;color:var(--text2);margin-top:2px;">정보통신 · 소프트웨어 개발</div>
              </div>
            </div>
            <!-- 항목별 수평 바 차트 -->
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="font-size:12px;font-weight:700;color:var(--text2);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px;">항목별 세부 점수</div>
              <!-- 자격증 -->
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                  <span style="font-weight:600;">🏅 보유 자격증 일치율</span>
                  <span style="color:var(--green);font-weight:700;">95%</span>
                </div>
                <div style="height:8px;background:var(--bg4);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:95%;background:linear-gradient(90deg,var(--green),#34d399);border-radius:4px;"></div>
                </div>
              </div>
              <!-- 전공 -->
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                  <span style="font-weight:600;">🎓 전공 관련성</span>
                  <span style="color:var(--accent);font-weight:700;">88%</span>
                </div>
                <div style="height:8px;background:var(--bg4);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:88%;background:linear-gradient(90deg,var(--accent),#7b96ff);border-radius:4px;"></div>
                </div>
              </div>
              <!-- GPA -->
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                  <span style="font-weight:600;">📊 GPA 달성률</span>
                  <span style="color:var(--accent);font-weight:700;">84%</span>
                </div>
                <div style="height:8px;background:var(--bg4);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:84%;background:linear-gradient(90deg,var(--accent),#7b96ff);border-radius:4px;"></div>
                </div>
              </div>
              <!-- 역량 점수 -->
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                  <span style="font-weight:600;">⚡ 직무 역량 점수</span>
                  <span style="color:var(--purple);font-weight:700;">72%</span>
                </div>
                <div style="height:8px;background:var(--bg4);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:72%;background:linear-gradient(90deg,var(--purple),#a78bfa);border-radius:4px;"></div>
                </div>
              </div>
              <!-- 이수 학점 -->
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
                  <span style="font-weight:600;">📚 이수 학점 달성률</span>
                  <span style="color:var(--amber);font-weight:700;">71%</span>
                </div>
                <div style="height:8px;background:var(--bg4);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:71%;background:linear-gradient(90deg,var(--amber),#fbbf24);border-radius:4px;"></div>
                </div>
              </div>
              <!-- 부족한 항목 안내 -->
              <div style="margin-top:6px;padding:10px 12px;background:var(--amber-bg);border-radius:var(--radius-sm);border:1px solid #fde68a;">
                <div style="font-size:11px;font-weight:700;color:var(--amber);margin-bottom:3px;">⚠ 보완 추천</div>
                <div style="font-size:11px;color:var(--text2);">TOEIC 취득 · AWS SAA 준비 · 이수 학점 38학점 추가 필요</div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid-2" style="margin-bottom:16px;">
          <!-- 자격증 / 대외활동 / 어학성적 탭 -->
          <div class="card">
            <div class="tabs" style="margin-bottom:14px;">
              <button class="tab-btn active" onclick="switchStatusTab('cert',this)">자격증</button>
              <button class="tab-btn" onclick="switchStatusTab('activity',this)">대외활동</button>
              <button class="tab-btn" onclick="switchStatusTab('lang',this)">어학성적</button>
            </div>
            <div id="st-cert">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏅 자격증</span><span class="card-action">+ 추가</span></div>
              <div class="cert-item"><div class="cert-icon">📋</div><div class="cert-name">정보처리기사</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2025.06</span></div>
              <div class="cert-item"><div class="cert-icon">🖥️</div><div class="cert-name">SQLD</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2024.12</span></div>
              <div class="cert-item"><div class="cert-icon">🌐</div><div class="cert-name">TOEIC</div><span class="badge badge-amber">준비중</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">목표 650</span></div>
              <div class="cert-item"><div class="cert-icon">☁️</div><div class="cert-name">AWS SAA</div><span class="badge badge-blue">목표</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2026.08</span></div>
            </div>
            <div id="st-activity" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏆 수상 및 대외활동</span><span class="card-action">+ 추가</span></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--accent);"></div><div class="activity-body"><div class="activity-title">교내 해커톤 최우수상</div><div class="activity-meta">한국대학교 · 2025.11 · 교내</div></div></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--green);"></div><div class="activity-body"><div class="activity-title">SW 마에스트로 13기 수료</div><div class="activity-meta">과학기술정보통신부 · 2025.08 · 대외</div></div></div>
              <div class="activity-item"><div class="activity-dot" style="background:var(--amber);"></div><div class="activity-body"><div class="activity-title">오픈소스 기여 활동</div><div class="activity-meta">GitHub · 2025.03 ~ 현재 · 대외</div></div></div>
            </div>
            <div id="st-lang" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🌍 어학 성적</span><span class="card-action">+ 추가</span></div>
              <div class="cert-item"><div class="cert-icon" style="background:var(--sky-bg);">🇺🇸</div><div class="cert-name">TOEIC</div><span class="badge badge-amber">준비중</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">목표 650점</span></div>
              <div class="cert-item"><div class="cert-icon" style="background:var(--green-bg);">🇯🇵</div><div class="cert-name">JLPT N3</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2024.07</span></div>
              <div style="margin-top:12px;padding:12px;background:var(--bg3);border-radius:var(--radius-sm);border:1px dashed var(--border2);"><div style="font-size:12px;color:var(--text2);font-weight:500;">+ 성적 추가하기 (IELTS, TOEFL, HSK 등)</div></div>
            </div>
          </div>

          <!-- AI 로드맵 -->
          <div class="card">
            <div class="card-header"><span class="card-title">🤖 AI 추천 커리어 로드맵</span><span class="badge badge-blue">백엔드 개발자</span></div>
            <div class="roadmap">
              <div class="roadmap-item done"><div class="roadmap-title">기초 CS 지식 강화</div><div class="roadmap-desc">자료구조, 알고리즘, 운영체제 이수</div></div>
              <div class="roadmap-item done"><div class="roadmap-title">데이터베이스 자격증</div><div class="roadmap-desc">SQLD 취득 완료</div></div>
              <div class="roadmap-item current"><div class="roadmap-title">클라우드 역량 강화</div><div class="roadmap-desc">AWS SAA 준비 중 · 현재 단계</div></div>
              <div class="roadmap-item"><div class="roadmap-title">실무 프로젝트 경험</div><div class="roadmap-desc">인턴십 또는 팀 프로젝트 참여</div></div>
              <div class="roadmap-item"><div class="roadmap-title">포트폴리오 완성 및 취업</div><div class="roadmap-desc">GitHub 정리, 이력서 작성, 채용 지원</div></div>
            </div>
          </div>
        </div>

        <!-- 스킬 (보유 능력) -->
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <span class="card-title">⚡ 스킬 (보유 능력)</span>
            <button class="btn btn-ghost btn-sm">+ 스킬 추가</button>
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;">
            <!-- 카테고리별 스킬 그룹 -->
            <div>
