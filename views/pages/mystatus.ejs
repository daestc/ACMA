<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>MyStatus</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'mystatus', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: 'MyStatus', user: user }) %>

		<div class="page-content">
    <!-- ══ MYSTATUS ══ -->
    <div class="page-content">

        <!-- 사람인 포트폴리오 배너 -->
        <div class="portfolio-banner">
          <div class="portfolio-name" id="profile-name">...</div>
          <div class="portfolio-meta" id="profile-meta">...</div>
          <div class="portfolio-tags">
            <span class="portfolio-tag" id="profile-job">...</span>
            <span class="portfolio-tag" id="profile-certification">...</span>
          </div>
        </div>

        <!-- ① 학업 현황 요약 통계 카드 (홈에서 이동) -->
        <div class="grid-4" style="margin-bottom:16px;">
          <div class="stat-card blue"><div class="stat-icon">📊</div><div class="stat-label">현재 평점</div><div class="stat-value" id="credit-avg">...</div></div>
          <div class="stat-card green"><div class="stat-icon">📚</div><div class="stat-label">이수 학점</div><div class="stat-value" id="credit-earned">...</div></div>
          <div class="stat-card amber"><div class="stat-icon">📝</div><div class="stat-label">이번 주 목표달성</div><div class="stat-value" id="study-time">...</div></div>
          <div class="stat-card purple"><div class="stat-icon">🏅</div><div class="stat-label">취득 자격증</div><div class="stat-value" id="certificates">...</div></div>
        </div>

        <!-- ② 이수 현황 (학사관리에서 이동) -->
        <!-- 영역별 이수 현황 + 학기별 성적 이력 -->
          <div class="grid-2">
            <div class="card">
                <div class="card-title" style="margin-bottom:16px;"> 영역별 이수 현황</div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공필수</span><span id="pv-major-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-req" class="progress-fill fill-blue" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공선택</span><span id="pv-major-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-el" class="progress-fill fill-purple" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양필수</span><span id="pv-gen-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-req" class="progress-fill fill-green" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양선택</span><span id="pv-gen-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-el" class="progress-fill fill-amber" style="width:0%"></div></div></div>
                <div class="progress-wrap" style="margin-bottom:0;"><div class="progress-header"><span class="progress-label">총 이수 학점</span><span id="pv-total" class="progress-value">-</span></div><div class="progress-track" style="height:10px;"><div id="pf-total" class="progress-fill fill-blue" style="width:0%"></div></div></div>
            </div>
          <div class="card">
              <div class="card-title" style="margin-bottom:14px;"> 학기별 성적 이력</div>
              <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;">
                  <thead>
                    <tr style="border-bottom:2px solid var(--border);">
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">학기</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">이수학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">취득학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">GPA</th>
                    </tr>
                  </thead>
                  <tbody id="semester-gpa-history-body">
                    <tr>
                      <td colspan="4" style="padding:14px 10px;font-size:13px;color:var(--text2);text-align:center;">학기별 데이터를 불러오는 중...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:20px;">
                <div style="text-align:center;">
                  <div id="semester-gpa-average" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--accent);">-</div>
                  <div style="font-size:11px;color:var(--text2);">누적 평점</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-best" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--green);">-</div>
                  <div style="font-size:11px;color:var(--text2);">최고 학기</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-count" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--purple);">-</div>
                  <div style="font-size:11px;color:var(--text2);">총 취득 학점</div>
                </div>
              </div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:16px;"></div>
        <div class="grid-2" style="margin-bottom:16px;">
          <!-- 자격증 / 대외활동 / 어학성적 탭 -->
          <div class="card">
            <div class="tabs" style="margin-bottom:14px;">
              <button class="tab-btn active" onclick="switchStatusTab('cert',this)">자격증</button>
              <button class="tab-btn" onclick="switchStatusTab('activity',this)">대외활동</button>
              <button class="tab-btn" onclick="switchStatusTab('lang',this)">어학성적</button>
              <button class="tab-btn" onclick="switchStatusTab('skill',this)">스킬</button>
            </div>
            <div id="st-cert">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏅 자격증</span><span class="card-action">+ 추가</span></div>
              <div class="cert-item"><div class="cert-icon">📋</div><div class="cert-name">정보처리기사</div><span class="badge badge-green">취득</span><span style="font-size:11px;color:var(--text2);margin-left:4px;">2025.06</span></div>
            </div>
            <div id="st-activity" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🏆 수상 및 대외활동</span><button type="button" class="btn btn-accent btn-sm" id="award-open-btn">+ 수상경력 추가</button></div>
            </div>
            <div id="st-lang" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🌍 어학 성적</span><button type="button" class="btn btn-accent btn-sm" id="language-open-btn">+ 추가</button></div>
              <div style="margin-top:12px;padding:12px;background:var(--bg3);border-radius:var(--radius-sm);border:1px dashed var(--border2);"><div style="font-size:12px;color:var(--text2);font-weight:500;">+ 성적 추가하기 (IELTS, TOEFL, HSK 등)</div></div>
            </div>
            <div id="st-skill" style="display:none;">
              <div class="card-header" style="margin-bottom:12px;"><span class="card-title">🛠 보유 스킬</span><button type="button" class="btn btn-accent btn-sm" id="skill-open-btn">+ 추가</button></div>
            </div>
          </div>

          <!-- AI 진단 요약 -->
          <div class="card">
            <div class="card-header">
              <span class="card-title">🩺 AI 진로 진단 요약</span>
              <span class="badge badge-blue" id="diag-summary-badge" style="display:none;"></span>
            </div>
            <div id="diag-summary-box">
              <div style="padding:14px 10px;font-size:13px;color:var(--text2);text-align:center;">진단 정보를 불러오는 중...</div>
            </div>
          </div>
        </div>

        <!-- 경험 / 활동 / 교육 -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">🗂 경험 / 활동 / 교육</span>
            <div style="display:flex;gap:6px;">
              <button type="button" class="btn btn-ghost btn-sm" id="experience-open-btn">+ 추가</button>
            </div>
          </div>

          <!-- 경험 탭 -->
          <div id="exp-work">
            <div class="exp-item">
              <div class="exp-dot" style="background:var(--accent);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                </div>
              </div>
            </div>
            <div class="exp-item" style="border-bottom:none;">
              <div class="exp-dot" style="background:var(--purple);"></div>
              <div class="exp-body">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                </div>
              </div>
            </div>
          </div>
		</div>
	</main>

	<!-- 모달 -->
	<%- include('../partials/modals/mypage', { user: user }) %>
  <%- include('../partials/modals/award-modal') %>
  <%- include('../partials/modals/experience-modal') %>
  <%- include('../partials/modals/language-modal') %>
  <%- include('../partials/modals/skill-modal') %>

	<script src="/js/common.js"></script>
	<script src="/js/mystatus.js"></script>
  <script src="/js/spec-modals.js"></script>
</body>

</html>