<!DOCTYPE html>
<html lang="ko">
<head>
  <%- include('../partials/head') %>
  <title>플랜</title>
</head>
<body>

<%- include('../partials/sidebar', { currentPage: 'payment', user }) %>

<main class="main-content">
  <%- include('../partials/topbar', { pageTitle: '플랜', user }) %>

  <div class="page-content">

    <div style="margin-bottom:28px;">
      <h2 style="font-size:20px;font-weight:700;margin-bottom:6px;">구독 플랜</h2>
      <p style="font-size:14px;color:var(--text2);">현재 이용 중인 플랜과 사용량을 확인하고 업그레이드할 수 있습니다.</p>
    </div>

    <!-- 오늘 사용량 요약 (무료 플랜만 표시) -->
    <% if (user.planType !== 'premium') {
      const today = new Date().toISOString().slice(0, 10);
      const quizUsed = (user.dailyUsage?.quiz?.date === today) ? (user.dailyUsage.quiz.count || 0) : 0;
      const sumUsed  = (user.dailyUsage?.summary?.date === today) ? (user.dailyUsage.summary.count || 0) : 0;
    %>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px;">
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;">
        <div style="font-size:12px;color:var(--text2);margin-bottom:6px;">오늘 퀴즈 사용량</div>
        <div style="font-size:22px;font-weight:700;margin-bottom:8px;"><%= quizUsed %><span style="font-size:14px;font-weight:400;color:var(--text2);"> / 10회</span></div>
        <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden;">
          <div style="height:100%;width:<%= Math.min(100, Math.round(quizUsed / 10 * 100)) %>%;background:#534AB7;border-radius:2px;"></div>
        </div>
      </div>
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;">
        <div style="font-size:12px;color:var(--text2);margin-bottom:6px;">오늘 요약 사용량</div>
        <div style="font-size:22px;font-weight:700;margin-bottom:8px;"><%= sumUsed %><span style="font-size:14px;font-weight:400;color:var(--text2);"> / 5회</span></div>
        <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden;">
          <div style="height:100%;width:<%= Math.min(100, Math.round(sumUsed / 5 * 100)) %>%;background:#1D9E75;border-radius:2px;"></div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- 플랜 카드 3개 -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px;">

      <!-- 무료 플랜 -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px;">
        <div style="font-size:24px;">🌱</div>
        <div>
          <div style="font-size:16px;font-weight:700;margin-bottom:4px;">무료</div>
          <div style="font-size:24px;font-weight:800;">₩0<span style="font-size:14px;font-weight:400;color:var(--text2);"> / 월</span></div>
        </div>
        <p style="font-size:13px;color:var(--text2);line-height:1.6;margin:0;">기본 AI 기능 무료 제공.<br>일 제한 내에서 자유롭게 이용</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:8px;flex:1;">
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>퀴즈 하루 10회</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>요약 하루 5회</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>자정(00:00) 자동 초기화</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;color:var(--text2);"><span>✗</span>무제한 이용</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;color:var(--text2);"><span>✗</span>포트폴리오 AI 생성</li>
        </ul>
        <% if (user.planType !== 'premium') { %>
        <button style="padding:10px;border-radius:10px;border:1.5px solid #1D9E75;background:transparent;color:#0F6E56;font-size:13px;font-weight:600;cursor:default;">현재 플랜</button>
        <% } else { %>
        <button class="btn btn-ghost btn-sm" style="width:100%;padding:10px;" onclick="if(confirm('무료 플랜으로 전환하시겠습니까?')) alert('해지 기능 준비 중입니다.')">무료로 전환</button>
        <% } %>
      </div>

      <!-- 프리미엄 플랜 -->
      <div style="background:var(--bg2);border:2px solid #534AB7;border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px;position:relative;">
        <span style="position:absolute;top:16px;right:16px;background:#EEEDFE;color:#3C3489;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;">추천</span>
        <div style="font-size:24px;">👑</div>
        <div>
          <div style="font-size:16px;font-weight:700;margin-bottom:4px;">프리미엄</div>
          <div style="font-size:24px;font-weight:800;">₩9,900<span style="font-size:14px;font-weight:400;color:var(--text2);"> / 월</span></div>
        </div>
        <p style="font-size:13px;color:var(--text2);line-height:1.6;margin:0;">모든 AI 기능 무제한.<br>제한 없이 학습에 집중</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:8px;flex:1;">
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>퀴즈 무제한</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>요약 무제한</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>포트폴리오 AI 생성 <span style="font-size:11px;color:var(--text2);">(출시 예정)</span></li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>월 정기 결제 / 언제든 해지</li>
        </ul>
        <% if (user.planType === 'premium') { %>
        <button style="padding:10px;border-radius:10px;border:none;background:#534AB7;color:#fff;font-size:13px;font-weight:600;cursor:default;">현재 플랜</button>
        <% } else { %>
        <button style="padding:10px;border-radius:10px;border:none;background:#534AB7;color:#fff;font-size:13px;font-weight:600;cursor:pointer;" onclick="startPremium()">프리미엄 시작</button>
        <% } %>
      </div>

      <!-- 포인트 충전 -->
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px;">
        <div style="font-size:24px;">🪙</div>
        <div>
          <div style="font-size:16px;font-weight:700;margin-bottom:4px;">포인트 충전</div>
          <div style="font-size:24px;font-weight:800;">₩100<span style="font-size:14px;font-weight:400;color:var(--text2);"> / 회</span></div>
        </div>
        <p style="font-size:13px;color:var(--text2);line-height:1.6;margin:0;">한도 초과 시 포인트로<br>즉시 추가 이용</p>
        <div style="background:var(--bg3);border-radius:10px;padding:12px;">
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px;">보유 포인트</div>
          <div style="font-size:20px;font-weight:700;"><%= (user.pointBalance || 0).toLocaleString() %>원</div>
        </div>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:8px;flex:1;">
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>퀴즈 · 요약 모두 적용</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>잔여 포인트 자동 차감</li>
          <li style="font-size:13px;display:flex;align-items:center;gap:8px;"><span style="color:#1D9E75;font-weight:700;">✓</span>유효기간 없음</li>
        </ul>
        <button class="btn btn-ghost btn-sm" style="width:100%;padding:10px;" onclick="chargePoints()">포인트 충전</button>
      </div>

    </div>

    <!-- 쿨타임 안내 -->
    <div style="border-left:3px solid #534AB7;border-radius:0 12px 12px 0;background:var(--bg2);padding:16px 20px;margin-bottom:20px;">
      <div style="font-size:13px;font-weight:700;margin-bottom:6px;">무료 플랜 쿨타임 안내</div>
      <div style="font-size:13px;color:var(--text2);line-height:1.7;">
        퀴즈 10회 / 요약 5회는 매일 자정(00:00)에 초기화됩니다.<br>
        한도를 초과한 경우 포인트로 즉시 이용하거나, 프리미엄으로 전환하면 제한 없이 사용할 수 있습니다.
      </div>
    </div>

    <div style="text-align:right;">
      <a href="/payment/history" style="font-size:13px;color:var(--text2);text-decoration:none;">결제 내역 보기 →</a>
    </div>

  </div>
</main>

<script>
function startPremium() {
  alert('토스페이먼츠 결제 연동 준비 중입니다.');
}
function chargePoints() {
  alert('포인트 충전 준비 중입니다.');
}
</script>

</body>
</html>
