<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>회원가입</title>
</head>

<body>

<!-- ══ REGISTER ════════════════════════════ -->
<div class="auth-wrap">
    <div class="auth-card">
      <a class="auth-logo" href="/"><div class="logo-icon">A</div><span class="logo-text">AcadMe</span></a>
      <h2>회원가입</h2>
      <p class="auth-sub">어떤 유형의 학생인가요?</p>
      <div class="user-type-select">
        <div class="user-type-btn active" onclick="selectType(this)"><div class="icon">🎓</div><div class="label">대학생</div></div>
        <div class="user-type-btn" onclick="selectType(this)"><div class="icon">📚</div><div class="label">초·중·고</div></div>
      </div>

      <% if (error) { %><p class="auth-error"><%= error %></p><% } %>

      <form id="registerForm" method="POST" action="/auth/register" novalidate>

        <div class="form-group">
          <label>이름</label>
          <input type="text" id="name" name="name" placeholder="홍길동" autocomplete="name">
          <span class="field-msg" id="name-msg"></span>
        </div>

        <div class="form-group">
          <label>이메일</label>
          <input type="email" id="email" name="email" placeholder="example@university.ac.kr" autocomplete="email">
          <span class="field-msg" id="email-msg"></span>
        </div>

        <div class="form-group">
          <label>대학교</label>
          <input type="text" id="university" name="university" placeholder="한국대학교">
          <span class="field-msg" id="university-msg"></span>
        </div>

        <div class="form-group">
          <label>전공</label>
          <input type="text" id="major" name="major" placeholder="컴퓨터공학과">
          <span class="field-msg" id="major-msg"></span>
        </div>

        <div class="form-group">
          <label>비밀번호</label>
          <div style="position:relative;">
            <input type="password" id="password" name="password" placeholder="영문 + 숫자 포함 8자 이상" autocomplete="new-password" style="width:100%;padding-right:38px;">
            <button type="button" onclick="togglePw('password',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
          </div>
          <span class="field-msg" id="password-msg"></span>
        </div>

        <div class="form-group">
          <label>비밀번호 확인</label>
          <div style="position:relative;">
            <input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="비밀번호 재입력" autocomplete="new-password" style="width:100%;padding-right:38px;">
            <button type="button" onclick="togglePw('passwordConfirm',this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text2);padding:0;line-height:1;display:flex;align-items:center;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
          </div>
          <span class="field-msg" id="passwordConfirm-msg"></span>
        </div>

        <button type="submit" class="btn-primary">가입 완료</button>
      </form>

      <div class="auth-footer">이미 계정이 있으신가요? <a href="/auth/login">로그인</a></div>
    </div>
</div>

<script>
const _eyeOpen = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const _eyeOff  = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePw(id, btn) {
  const el = document.getElementById(id);
  const show = el.type === 'password';
  el.type = show ? 'text' : 'password';
  btn.innerHTML = show ? _eyeOff : _eyeOpen;
}
</script>
<script src="/js/register.js"></script>
</body>

</html>
