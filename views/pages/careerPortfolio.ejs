<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head', { title: pageTitle }) %>
	<title>진로 포트폴리오</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'careerPortfolio', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '진로 포트폴리오', user: user }) %>

		<div class="page-content">
      <div id="pf-all-blocked-banner" style="display:none;"></div>

      <!-- ══ 준비도 ══ -->
      <div class="card" style="margin-bottom:16px;">
        <div class="card-header">
          <span class="card-title">준비도</span>
          <span class="badge badge-blue" id="pf-total-badge">-</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;" id="pf-breakdown"></div>
        <div id="pf-blockers"></div>
        <div id="pf-missing"></div>
        <div style="margin-top:16px;text-align:right;">
          <button class="btn btn-accent" id="pf-generate-btn" onclick="generatePortfolio()" disabled>포트폴리오 생성하기</button>
        </div>
      </div>

      <!-- ══ 생성 중 ══ -->
      <div class="card" id="pf-pending" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:14px;color:var(--accent);">포트폴리오를 생성하는 중입니다... (최대 1분 소요)</div>
      </div>

      <!-- ══ 생성 실패 ══ -->
      <div class="card" id="pf-failed" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:14px;color:var(--red);" id="pf-failed-msg">생성에 실패했습니다.</div>
      </div>

      <!-- ══ 빈 상태 ══ -->
      <div class="card" id="pf-empty" style="display:none;text-align:center;padding:48px 20px;">
        <div style="font-size:36px;margin-bottom:12px;">💼</div>
        <div style="font-size:16px;font-weight:700;margin-bottom:8px;">아직 생성된 포트폴리오가 없습니다</div>
        <p style="font-size:13px;color:var(--text2);line-height:1.6;">위에서 준비도를 채운 뒤 생성해 보세요.</p>
      </div>

      <!-- ══ 포트폴리오 본문 ══ -->
      <div id="pf-result" style="display:none;">
        <div class="card" style="margin-bottom:16px;">
          <div class="card-header">
            <span class="card-title" id="pf-job-title">-</span>
            <div style="display:flex;gap:8px;">
              <a id="pf-print-link" href="#" target="_blank" class="btn btn-ghost btn-sm">🖨 인쇄용으로 보기</a>
              <button class="btn btn-ghost btn-sm" onclick="generatePortfolio()">다시 생성</button>
            </div>
          </div>
          <p style="font-size:13px;color:var(--text2);line-height:1.7;margin-top:8px;" id="pf-summary"></p>
          <div id="pf-job-mismatch" style="display:none;margin-top:12px;padding:10px 14px;background:var(--red-bg);color:var(--red);border-radius:8px;font-size:12px;line-height:1.6;"></div>
        </div>

        <div id="pf-sections" style="display:flex;flex-direction:column;gap:12px;"></div>
      </div>
		</div>

	</main>

	<!-- 모달 -->
	<%- include('../partials/modals/mypage', { user: user }) %>

	<script src="/js/common.js"></script>
	<script src="/js/careerAi.js"></script>
	<script src="/js/careerPortfolio.js"></script>
</body>

</html>
