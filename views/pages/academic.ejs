<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>학사관리</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'academic', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '학사관리', user: user }) %>

		<div class="page-content">
    <!-- ══ ACADEMIC ══ -->
    <div class="page-content">
        <div class="tabs">
          <button class="tab-btn active" onclick="switchAcademicTab('gpa',this)">학점 등록</button>
          <button class="tab-btn" onclick="switchAcademicTab('credit',this)">이수 현황</button>
          <button class="tab-btn" onclick="switchAcademicTab('grad',this)">졸업요건</button>
        </div>

        <!-- GPA 계산기 -->
        <div id="ac-gpa">
          <div class="grid-2">
            <div class="card">
              <div class="card-header">
                <span class="card-title">학기 과목 입력</span>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span id="semester-status-badge" class="badge badge-blue">-</span>
                  <button type="button" id="semester-close-btn" class="btn" style="font-size:12px;padding:5px 10px;" onclick="toggleSemesterClose()">마감</button>
                  <select class="select-field" name="semester" style="font-size:12px;padding:5px 10px;">
                    <option value="2026-1">2026-1학기</option>
                    <option value="2025-2">2025-2학기</option>
                    <option value="2025-1">2025-1학기</option>
                    <option value="2024-2">2024-2학기</option>
                    <option value="2024-1">2024-1학기</option>
                    <option value="2023-2">2023-2학기</option>
                    <option value="2023-1">2023-1학기</option>
                  </select>
                </div>
              </div>
              <div id="subject-list">
                <div class="subject-row">
                  <!-- 읽기 전용으로 변경 -->
                  <input class="input-field" name="subjectName" placeholder="과목명" style="flex:2;" disabled>
                  <select class="select-field" name="subjectType" style="min-width:120px;" disabled>
                    <option value="major_required">전필</option>
                    <option value="major_elective">전선</option>
                    <option value="general_required">교필</option>
                    <option value="general_elective">교선</option>
                    <option value="free">일선</option>
                  </select>
                  <select class="select-field" name="credits" disabled>
                    <option value="3">3학점</option><option value="2">2학점</option><option value="1">1학점</option>
                  </select>
                  <select class="select-field" name="grade" onchange="calcGPA()" disabled>
                    <option value="A+">A+</option><option value="A">A</option><option value="B+">B+</option><option value="B">B</option><option value="C+">C+</option><option value="C">C</option><option value="D+">D+</option><option value="D">D</option><option value="F">F</option>
                  </select>
                </div>
                <div class="subject-row">
                  <input class="input-field" name="subjectName" placeholder="과목명" style="flex:2;" disabled>
                  <select class="select-field" name="subjectType" style="min-width:120px;" disabled>
                    <option value="major_required">전필</option>
                    <option value="major_elective">전선</option>
                    <option value="general_required">교필</option>
                    <option value="general_elective">교선</option>
                    <option value="free">일선</option>
                  </select>
                  <select class="select-field" name="credits" disabled>
                    <option value="3">3학점</option><option value="2">2학점</option><option value="1">1학점</option>
                  </select>
                  <select class="select-field" name="grade" onchange="calcGPA()" disabled>
                    <option value="B+">B+</option><option value="A+">A+</option><option value="A">A</option><option value="B">B</option>
                  </select>
                </div>
                <div class="subject-row">
                  <input class="input-field" name="subjectName" placeholder="과목명" style="flex:2;" disabled>
                  <select class="select-field" name="subjectType" style="min-width:120px;" disabled>
                    <option value="major_required">전필</option>
                    <option value="major_elective">전선</option>
                    <option value="general_required">교필</option>
                    <option value="general_elective">교선</option>
                    <option value="free">일선</option>
                  </select>
                  <select class="select-field" name="credits" disabled>
                    <option value="2">2학점</option><option value="3">3학점</option><option value="1">1학점</option>
                  </select>
                  <select class="select-field" name="grade" onchange="calcGPA()" disabled>
                    <option value="A">A</option><option value="A+">A+</option><option value="B+">B+</option><option value="B">B</option>
                  </select>
                </div>
              </div>
              <div id="semester-close-hint" style="display:none;font-size:12px;color:var(--accent);margin-top:8px;">
                모든 과목 성적이 입력됐습니다 — 이 학기를 마감할까요?
              </div>
              <button type="button" class="btn btn-accent" style="margin-top:8px;width:100%;" onclick="saveAcademicData()">저장</button>
            </div>
            <div class="card" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
              <div class="gpa-display">
                <div class="gpa-label">이번 학기 예상 평점</div>
                <div><span class="gpa-value" id="gpa-result">3.83</span><span class="gpa-max"> / 4.5</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── 이수 현황 ── -->
        <div id="ac-credit" style="display:none;">
          <div class="card" style="margin-bottom:16px;">
            <div class="card-header">
              <span class="card-title"> 학기별 학점 추이</span>
              <div style="display:flex;align-items:center;gap:14px;font-size:11px;flex-wrap:wrap;">
                <span style="display:flex;align-items:center;gap:5px;"><span style="width:20px;height:2px;background:var(--accent);display:inline-block;border-radius:1px;"></span>실제 GPA</span>
                <span style="display:flex;align-items:center;gap:5px;"><span style="width:8px;height:8px;background:var(--green);border-radius:50%;display:inline-block;"></span>최고 학기</span>
              </div>
            </div>
            <div style="overflow-x:auto;">
              <div id="semester-gpa-chart" data-target-gpa="3.9" style="min-width:520px;min-height:260px;display:flex;align-items:center;justify-content:center;color:var(--text2);font-size:13px;padding:12px 0;">
                학기별 학점을 불러오는 중...
              </div>
            </div>
          </div>

          <!-- 영역별 이수 현황 + 학기별 성적 이력 -->
          <div class="grid-2">
            <div class="card">
                <div class="card-title" style="margin-bottom:16px;">📂 영역별 이수 현황</div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공필수</span><span id="pv-major-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-req" class="progress-fill fill-blue" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">전공선택</span><span id="pv-major-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-major-el" class="progress-fill fill-purple" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양필수</span><span id="pv-gen-req" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-req" class="progress-fill fill-green" style="width:0%"></div></div></div>
                <div class="progress-wrap"><div class="progress-header"><span class="progress-label">교양선택</span><span id="pv-gen-el" class="progress-value">-</span></div><div class="progress-track"><div id="pf-gen-el" class="progress-fill fill-amber" style="width:0%"></div></div></div>
                <div class="progress-wrap" style="margin-bottom:0;"><div class="progress-header"><span class="progress-label">총 이수 학점</span><span id="pv-total" class="progress-value">-</span></div><div class="progress-track" style="height:10px;"><div id="pf-total" class="progress-fill fill-blue" style="width:0%"></div></div></div>
              </div>

            <!-- 학기별 성적 이력 테이블 (PDF 예시 그대로) -->
            <div class="card">
              <div class="card-title" style="margin-bottom:14px;"> 학기별 성적 이력</div>
              <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;">
                  <thead>
                    <tr style="border-bottom:2px solid var(--border);">
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">학기</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">이수학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">취득학점</th>
                      <th style="font-size:11px;font-weight:700;color:var(--text2);padding:8px 10px;text-align:left;">GPA</th>
                    </tr>
                  </thead>
                  <tbody id="semester-gpa-history-body">
                    <tr>
                      <td colspan="4" style="padding:14px 10px;font-size:13px;color:var(--text2);text-align:center;">학기별 데이터를 불러오는 중...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:20px;">
                <div style="text-align:center;">
                  <div id="semester-gpa-average" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--accent);">-</div>
                  <div style="font-size:11px;color:var(--text2);">누적 평점</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-best" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--green);">-</div>
                  <div style="font-size:11px;color:var(--text2);">최고 학기</div>
                </div>
                <div style="text-align:center;">
                  <div id="semester-gpa-count" style="font-size:18px;font-weight:800;font-family:'DM Sans';color:var(--purple);">-</div>
                  <div style="font-size:11px;color:var(--text2);">총 취득 학점</div>
                </div>
              </div>
            </div>

            </div>

          </div>

          </div>

            <!-- ── 졸업요건 (읽기 전용) ── -->
            <div id="ac-grad" style="display:none;">
              <div id="gr-empty-state" class="card" style="display:none;">
                <div style="padding:36px 20px;text-align:center;">
                  <div style="font-size:36px;margin-bottom:12px;">📭</div>
                  <div style="font-size:16px;font-weight:700;margin-bottom:8px;">정보 없음</div>
                  <div id="gr-empty-message" style="font-size:13px;color:var(--text2);line-height:1.6;"></div>
                </div>
              </div>

              <div id="gr-readonly-content" class="card" style="display:none;">
                <div class="card-header">
                  <span class="card-title">졸업요건</span>
                  <span class="badge badge-blue" id="gr-major-badge">-</span>
                </div>
                <p style="font-size:12px;color:var(--text2);margin-bottom:14px;line-height:1.6;">
                  대학관계자가 등록한 졸업요건입니다. 학생은 조회만 가능합니다.
                </p>
                <div style="display:flex;flex-direction:column;gap:12px;">
                  <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;padding-bottom:6px;border-bottom:1px solid var(--border);">이수 학점 요건</div>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">총 졸업 필요 학점</label>
                      <input class="input-field" id="gr-total" type="number" min="0" style="width:100%;" readonly disabled>
                    </div>
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">전공필수</label>
                      <input class="input-field" id="gr-major-req" type="number" min="0" style="width:100%;" readonly disabled>
                    </div>
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">전공선택</label>
                      <input class="input-field" id="gr-major-el" type="number" min="0" style="width:100%;" readonly disabled>
                    </div>
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">교양필수</label>
                      <input class="input-field" id="gr-gen-req" type="number" min="0" style="width:100%;" readonly disabled>
                    </div>
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">교양선택</label>
                      <input class="input-field" id="gr-gen-el" type="number" min="0" style="width:100%;" readonly disabled>
                    </div>
                  </div>

                  <div style="font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;padding-bottom:6px;border-bottom:1px solid var(--border);margin-top:4px;">추가 이수 요건</div>

                  <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                      <div style="font-size:13px;font-weight:600;">졸업작품 이수 필요</div>
                      <div style="font-size:11px;color:var(--text2);">캡스톤디자인 또는 졸업논문</div>
                    </div>
                    <div class="toggle" id="gr-grad-work"><div class="toggle-knob"></div></div>
                  </div>

                  <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                      <div style="font-size:13px;font-weight:600;">캡스톤 디자인 이수 필요</div>
                      <div style="font-size:11px;color:var(--text2);">졸업요건에 캡스톤이 포함되는지 여부</div>
                    </div>
                    <div class="toggle" id="gr-capstone-design"><div class="toggle-knob"></div></div>
                  </div>

                  <div>
                    <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">외국어 성적 요건</label>
                    <div style="display:flex;gap:8px;">
                      <select class="select-field" id="gr-lang-type" style="flex:1;" disabled>
                        <option>TOEIC</option><option>TOEFL</option><option>IELTS</option><option>JLPT</option><option>없음</option>
                      </select>
                      <input class="input-field" id="gr-lang-score" placeholder="최소 점수" style="flex:1;" readonly disabled>
                    </div>
                  </div>

                  <div>
                    <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">필수 취득 자격증</label>
                    <div id="gr-cert-list" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px;min-height:28px;"></div>
                    <div id="gr-cert-empty" style="font-size:12px;color:var(--text2);display:none;">없음</div>
                  </div>

                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">인턴십 의무 이수</label>
                      <select class="select-field" id="gr-internship" style="width:100%;" disabled>
                        <option value="">미지정</option>
                        <option value="true">필수</option>
                        <option value="false">선택</option>
                      </select>
                    </div>
                    <div>
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">비교과 프로그램</label>
                      <select class="select-field" id="gr-nc-program" style="width:100%;" disabled>
                        <option value="">미지정</option>
                        <option value="true">필수</option>
                        <option value="false">선택</option>
                      </select>
                    </div>
                    <div style="grid-column:1 / -1;">
                      <label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">사회봉사 시간</label>
                      <input class="input-field" id="gr-volunteer" type="number" min="0" placeholder="-" style="width:100%;" readonly disabled>
                    </div>
                  </div>

                  <div id="grad-summary" style="margin-top:4px;padding:12px;background:var(--bg3);border-radius:var(--radius-sm);font-size:12px;color:var(--text2);line-height:1.7;"></div>
                </div>
              </div>
            </div>
		</div>

	</main>

	<!-- 모달 -->
	<%- include('../partials/modals/mypage', { user: user }) %>

	<script src="/js/common.js"></script>
	<script src="/js/academic.js"></script>
</body>

</html>