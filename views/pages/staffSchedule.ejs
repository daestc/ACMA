<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>학교 일정 등록</title>
	<style>
		.schedule-pagination {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 8px;
			margin-top: 16px;
		}
		.schedule-page-btn {
			text-decoration: none;
			color: #64748b;
			padding: 6px 12px;
			border-radius: 8px;
			background: white;
			border: 1px solid #e2e8f0;
			font-size: 0.85rem;
			font-weight: 500;
		}
		.schedule-page-btn:hover { background: #f1f5f9; color: #1e293b; }
		.schedule-page-btn.active { background: #1e293b; color: white; border-color: #1e293b; font-weight: 700; }
		.schedule-page-btn.disabled { color: #cbd5e1; background: #f8fafc; pointer-events: none; border-color: #e2e8f0; }
	</style>
</head>

<body>

	<%- include('../partials/sidebar', { currentPage: 'staffSchedule', user: user }) %>

	<main class="main-content">
		<%- include('../partials/topbar', { pageTitle: '학교 일정 등록', user: user }) %>

		<div class="page-content">
			<div class="grid-2" style="align-items:start;">

				<div class="card">
					<div class="card-header">
						<span class="card-title">📅 일정 등록</span>
						<span class="badge badge-blue"><%= user.university %></span>
					</div>

					<div style="display:flex;flex-direction:column;gap:10px;">
						<div>
							<label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">제목</label>
							<input class="input-field" id="sch-title" placeholder="예: 2026-1학기 수강신청" style="width:100%;">
						</div>
						<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
							<div>
								<label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">시작일</label>
								<input class="input-field" id="sch-start" type="date" style="width:100%;">
							</div>
							<div>
								<label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">종료일 (선택)</label>
								<input class="input-field" id="sch-end" type="date" style="width:100%;">
							</div>
						</div>
						<div>
							<label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">설명 (선택)</label>
							<textarea class="input-field" id="sch-desc" rows="3" placeholder="일정 안내 내용" style="width:100%;resize:vertical;"></textarea>
						</div>
						<button class="btn btn-accent" id="sch-submit-btn" style="width:100%;justify-content:center;" onclick="submitSchedule()">일정 등록</button>
						<div id="sch-msg" style="display:none;font-size:12px;border-radius:var(--radius-sm);padding:9px 12px;"></div>
					</div>
				</div>

				<div class="card">
					<div class="card-header">
						<span class="card-title">등록된 학교 일정</span>
						<span style="font-size:12px;color:var(--text2);">총 <%= totalSchedules %>건</span>
					</div>

					<% if (schedules.length === 0) { %>
						<p style="font-size:13px;color:var(--text2);padding:18px 0;text-align:center;">등록된 일정이 없습니다.</p>
					<% } else { %>
						<div style="display:flex;flex-direction:column;gap:8px;">
							<% schedules.forEach(s => { %>
								<div style="border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;">
									<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
										<div>
											<div style="font-size:14px;font-weight:700;"><%= s.title %></div>
											<div style="font-size:12px;color:var(--text2);margin-top:4px;">
												<%= new Date(s.startDate).toLocaleDateString('ko-KR') %>
												<% if (s.endDate) { %> ~ <%= new Date(s.endDate).toLocaleDateString('ko-KR') %><% } %>
											</div>
											<% if (s.description) { %>
												<div style="font-size:12px;color:var(--text2);margin-top:6px;line-height:1.5;"><%= s.description %></div>
											<% } %>
										</div>
										<button class="btn btn-ghost btn-sm" onclick="deleteSchedule('<%= s._id %>', this)">🗑</button>
									</div>
								</div>
							<% }) %>
						</div>

						<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
							<div class="schedule-pagination">
								<a href="/staff/schedules?page=<%= currentPageNum - 1 %>" class="schedule-page-btn <%= currentPageNum === 1 ? 'disabled' : '' %>">이전</a>
								<% for (let i = 1; i <= totalPages; i++) { %>
									<a href="/staff/schedules?page=<%= i %>" class="schedule-page-btn <%= currentPageNum === i ? 'active' : '' %>"><%= i %></a>
								<% } %>
								<a href="/staff/schedules?page=<%= currentPageNum + 1 %>" class="schedule-page-btn <%= currentPageNum === totalPages ? 'disabled' : '' %>">다음</a>
							</div>
						<% } %>
					<% } %>
				</div>

			</div>
		</div>
	</main>

	<%- include('../partials/modals/mypage', { user: user }) %>
	<script src="/js/common.js"></script>
	<script src="/js/staffSchedule.js"></script>
</body>

</html>
