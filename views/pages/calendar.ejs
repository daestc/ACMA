<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>캘린더</title>
</head>
<style>  <!--캘린더 일정 색깔 원-->
  .day-events {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .event-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  <!--일정 추가 css-->
  .event-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  }

  .event-modal-content {
    background: white;
   padding: 24px;
   border-radius: 12px;
    width: 360px;
  }

  .event-modal-content form {
    display: flex;
    flex-direction: column;
   gap: 12px;
  }

  .event-modal-content input,
  .event-modal-content textarea,
  .event-modal-content select {
    width: 100%;
    padding: 8px;
    margin-top: 4px;
  }
</style>
<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'calendar', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '캘린더', user: user }) %>

    <!-- ══ CALENDAR ══ -->
    <div class="page-content">
      <div class="view-tabs" style="display:flex; gap:8px; margin-bottom:16px;">
        <button id="cal-tab-month" class="btn btn-sm active" onclick="switchCalView('month')">월간 달력</button>
        <button id="cal-tab-week" class="btn btn-sm" onclick="switchCalView('week')">시간표</button>
      </div>

      <div id="cal-month-view">
        <div class="card">
          <div class="cal-header">
            <div class="cal-nav">
              <button id="prev-month" class="cal-nav-btn">‹</button>
              <span id="cal-month-title" class="cal-month"></span>
              <button id="next-month" class="cal-nav-btn">›</button>
            </div>
            <button id="open-event-form-btn" class="btn btn-accent btn-sm">+ 일정 추가</button>
          </div>

          <div id="calendar-grid" class="cal-grid"></div>
        </div>
      </div>

      <div id="cal-week-view" style="display:none;">
        <div class="card">
          <div class="cal-header">
            <span class="cal-month">주간 시간표</span>
            <button class="btn btn-accent btn-sm">+ 시간표 추가</button>
          </div>

          <div id="timetable-grid" class="timetable"></div>
        </div>
      </div>
	  </div>

	</main>

  <!--일정 추가-->
  <div id="event-modal" class="event-modal" style="display:none;">
    <div class="event-modal-content">
      <h3>일정 추가</h3>

      <form id="event-form">
        <label>
          제목
          <input type="text" id="event-title" required>
        </label>

        <label>
          설명
          <textarea id="event-description"></textarea>
        </label>

        <label>
          시작 날짜
          <input type="date" id="event-start-date" required>
        </label>

        <label>
          종료 날짜
          <input type="date" id="event-end-date">
        </label>

        <label>
          카테고리
          <select id="event-category">
            <option value="personal">개인</option>
           <option value="lecture">강의</option>
           <option value="exam">시험</option>
           <option value="assignment">과제</option>
           <option value="certification">자격증</option>
           <option value="notice">공지</option>
            <option value="other">기타</option>
          </select>
        </label>

        <label>
         색상
         <input type="color" id="event-color" value="#3B82F6">
        </label>

        <div style="display:flex; gap:8px; margin-top:16px;">
          <button type="submit" class="btn btn-accent btn-sm">저장</button>
          <button type="button" id="close-event-form-btn" class="btn btn-sm">취소</button>
        </div>
      </form>
    </div>
  </div>
	<!-- 모달 -->
	<%- include('../partials/modals/mypage', { user: user }) %>

	<script src="/js/common.js"></script>
	<script src="/js/calendar.js"></script>

  
</body>

</html>