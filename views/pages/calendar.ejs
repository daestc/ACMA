<!DOCTYPE html>
<html lang="ko">

<head>
	<%- include('../partials/head') %>
	<title>캘린더</title>
</head>

<body>

	<!-- 사이드바 -->
	<%- include('../partials/sidebar', { currentPage: 'calendar', user: user }) %>

	<main class="main-content">

		<!-- 상단 헤더 -->
		<%- include('../partials/topbar', { pageTitle: '캘린더', user: user }) %>

    <!-- ══ CALENDAR ══ -->
    <div class="page-content">
      <div class="view-tabs" style="display:flex; gap:8px; margin-bottom:16px;">
        <button id="cal-tab-month" class="btn btn-sm active" onclick="switchCalView('month')">월간 달력</button>
        <button id="cal-tab-week" class="btn btn-sm" onclick="switchCalView('week')">시간표</button>
      </div>

      <div id="cal-month-view">
        <div class="card">
          <div class="cal-header">
            <div class="cal-nav">
              <button id="prev-month" class="cal-nav-btn">‹</button>
              <span id="cal-month-title" class="cal-month"></span>
              <button id="next-month" class="cal-nav-btn">›</button>
            </div>
            <button id="open-event-form-btn" class="btn btn-accent btn-sm">+ 일정 추가</button>
          </div>

          <div id="calendar-grid" class="cal-grid"></div>
          <div id="selected-day-panel" class="selected-day-panel" style="display:none;">
            <h3 id="selected-day-title"></h3>
            <div id="selected-day-events"></div>
          </div>
        </div>
      </div>

      <div id="cal-week-view" style="display:none;">
        <div class="card">
          <div class="cal-header">
            <span class="cal-month">주간 시간표</span>
            
            <div style="display:flex; gap:8px;">
              <button id="open-lecture-search-btn" class="btn btn-ghost btn-sm">강의 검색</button>
              <button id="open-timetable-form-btn" class="btn btn-accent btn-sm">+ 시간표 추가</button>
            </div>
          </div>

          <div id="timetable-grid" class="timetable"></div>
        </div>
      </div>
	  </div>

	</main>

  <!--일정 추가-->

	<!-- 모달 -->
  <%- include('../partials/modals/calendarEventModal') %>
  <%- include('../partials/modals/timetableModal') %>
	<%- include('../partials/modals/mypage', { user: user }) %>


	<script>
		window.calendarUser = {
			university: <%- JSON.stringify(user?.university || '') %>
		};
	</script>
	<script src="/js/common.js"></script>
  <script src="/js/location.js"></script>
  <script src="/js/weather.js"></script>
  <script src="/js/timetable.js"></script>
	<script src="/js/calendar.js"></script>

</body>
</html>